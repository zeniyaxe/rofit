{
  "manifest_version": 3,
  "name": "RoFit Inspector",
  "short_name": "RoFit",
  "version": "1.0.0",
  "description": "Browse, inspect, compare and keep the saved avatar outfits on any Roblox profile.",
  "minimum_chrome_version": "113",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "RoFit Inspector",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png"
    }
  },
  "options_ui": {
    "page": "workspace.html#settings",
    "open_in_tab": true
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "permissions": [
    "storage",
    "alarms",
    "activeTab"
  ],
  "host_permissions": [
    "https://avatar.roblox.com/*",
    "https://thumbnails.roblox.com/*",
    "https://catalog.roblox.com/*",
    "https://economy.roblox.com/*",
    "https://inventory.roblox.com/*",
    "https://users.roblox.com/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://www.roblox.com/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'"
  },
  "web_accessible_resources": [
    {
      "resources": [
        "sheet.js"
      ],
      "matches": [
        "https://www.roblox.com/*"
      ],
      "use_dynamic_url": true
    }
  ]
}