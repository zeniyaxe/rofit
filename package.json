{
  "name": "rofit-inspector",
  "version": "2.0.0",
  "private": true,
  "description": "Browse, inspect, compare and keep other people's saved Roblox avatar outfits.",
  "type": "module",
  "scripts": {
    "build": "node scripts/build.mjs",
    "watch": "node scripts/build.mjs --watch",
    "typecheck": "tsc --noEmit",
    "test": "node --test tests/unit/*.test.ts",
    "test:e2e": "node tests/e2e/run.mjs",
    "zip": "node scripts/zip.mjs",
    "release": "npm run typecheck && npm run build && npm test && npm run zip",
    "test:perf": "node tests/perf/scroll.mjs"
  },
  "dependencies": {
    "lucide": "^1.52.0",
    "preact": "^11.0.0"
  },
  "devDependencies": {
    "@types/chrome": "^0.3.4",
    "archiver": "^8.0.0",
    "esbuild": "^0.28.2",
    "fake-indexeddb": "^6.2.5",
    "playwright": "^1.63.0",
    "typescript": "^7.0.2"
  }
}
