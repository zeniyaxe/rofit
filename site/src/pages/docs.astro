---
import '../styles/ported.css';
import Base from '../layouts/Base.astro';
import { docs } from '../pages.mjs';
// The body copy lives in pages.mjs (shared with the claim checks); the page chrome is this site's.
const body = docs().replace(/<header class="page-head">[\s\S]*?<\/header>/, '');
---
<Base title="Docs" description="Install RoFit and learn how to browse, inspect, compare, save and share outfits.">
  <header class="masthead">
    <div class="wrap">
      <h1>Using RoFit</h1>
      <p class="lead">Get started, find the controls, or <a class="link" href="/guides">browse the guides</a>.</p>
    </div>
  </header>
  <div class="ported docs-page">
    <Fragment set:html={body} />
  </div>
</Base>
<script>import '../app.ts';</script>
