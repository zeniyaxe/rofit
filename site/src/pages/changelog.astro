---
import Doc from '../layouts/Doc.astro';
import { releases } from '../lib/changelog';
const list = releases();
---
<Doc title="Changelog" lead="What changed in each version, straight from the extension’s own release notes." toc={false}>
  {list.map((r, i) => (
    <section class="rel" id={'v' + r.version}>
      <h2><span class="ver">{r.version}</span>{r.title && <span class="ttl">{r.title}</span>}{i === 0 && <span class="new">Latest</span>}</h2>
      <div set:html={r.html} />
    </section>
  ))}
</Doc>
<style is:global>
  .rel { padding-top: var(--s2); }
  .rel h2 { display: flex; flex-wrap: wrap; align-items: baseline; gap: 4px var(--s4); margin-top: 2.2em; padding-top: var(--s4); border-top: 1.5px solid var(--ink); }
  .rel:first-child h2 { margin-top: 0; }
  .rel .ver { font-family: var(--f-display); font-stretch: var(--wide); font-weight: 800; }
  .rel .ttl { font-family: var(--f-body); font-stretch: normal; font-weight: 600; font-size: .56em; letter-spacing: 0; color: var(--ink-2); }
  .rel .new { font-family: var(--f-body); font-stretch: normal; font-size: var(--t-micro); font-weight: 800; letter-spacing: .07em; text-transform: uppercase; background: var(--spot); color: var(--spot-ink); padding: 3px 8px; border-radius: var(--r-sm); }
  .rel h4 { font-size: var(--t-ui-l); margin-top: 1.4em; font-family: var(--f-body); font-stretch: normal; font-weight: 750; }
</style>
