---
import Base from '../layouts/Base.astro';
---
<Base title="Not found" noindex>
  <section class="lost">
    <div class="wrap">
      <p class="code" aria-hidden="true">404</p>
      <h1>Nothing on this hanger.</h1>
      <p>That page isn’t here. It may have moved, or the link may be mistyped. Share links look like <code>rofit.site/o/#1.…</code>; if you followed one, check it was copied completely.</p>
      <p class="row"><a class="btn" href="/">Go to the homepage</a><a class="btn line" href="/guides">Browse the guides</a></p>
    </div>
  </section>
</Base>
<style>
  .lost { padding: calc(var(--nav-h) + clamp(48px, 9vw, 120px)) 0 var(--s7); min-height: 70svh; }
  .code { font-family: var(--f-display); font-weight: 900; font-stretch: 116%; font-size: clamp(6rem, 22vw, 18rem); line-height: .75; letter-spacing: -.05em; color: var(--spot); }
  h1 { font-size: clamp(2.4rem, 6vw, 5rem); margin-top: var(--s5); max-width: 14ch; font-stretch: var(--narrow); text-transform: uppercase; font-weight: 900; }
  p { color: var(--ink-2); margin-top: var(--s4); max-width: 52ch; }
  code { background: var(--paper-2); padding: .05em .35em; border-radius: var(--r-sm); }
  .row { display: flex; flex-wrap: wrap; gap: var(--s3); margin-top: var(--s6); }
</style>
