---
import Doc from '../../layouts/Doc.astro';
import { GUIDES } from '../../lib/guides';
export function getStaticPaths() { return GUIDES.map((g) => ({ params: { slug: g.slug }, props: g })); }
const g = Astro.props;
const mods = import.meta.glob('../../guides/*.astro', { eager: true }) as Record<string, { default: any }>;
const Body = mods[`../../guides/${g.slug}.astro`].default;
---
<Doc title={g.title} lead={g.blurb} type="article"><Body /></Doc>
