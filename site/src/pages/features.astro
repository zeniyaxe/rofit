---
import '../styles/ported.css';
import Base from '../layouts/Base.astro';
import { features } from '../pages.mjs';
---
<Base title="RoFit Features" description="Browse, inspect, compare, and save Roblox outfits.">
  <div class="ported reference features-page">
    <Fragment set:html={features()} />
  </div>
</Base>
<style>
  .reference { padding-block: calc(var(--nav-h) + clamp(28px, 6vw, 80px)) 70px; }
  .reference :global(.page-head) { margin-bottom: clamp(28px, 5vw, 58px); }
  .reference :global(.page-head h1) { font-size: clamp(2.5rem, 6vw, 5rem); }
  .reference :global(.page-head .lede) { color: var(--ink-2); max-width: 64ch; margin-top: 14px; }
  .features-page :global(.feature-nav) { display:flex; flex-wrap:wrap; gap:8px; margin-bottom:26px; }
  .features-page :global(.feature-nav a) { display:inline-flex; align-items:center; min-height:42px; padding:6px 12px; border:1px solid var(--line); border-radius:9px; font-size:.9rem; font-weight:650; }
  .features-page :global(.feat-art) { border:1px solid var(--line); }
  .features-page :global(.feat h2) { margin-block:8px 12px; }
  @media(max-width:700px) { .features-page :global(.feat:nth-of-type(even) .feat-art) { order:0; } }
</style>
