---
import { star, hero, knownItems, buyNow, money } from '../lib/real';
import { examplePrice } from '../lib/example-price';

const others = star.outfits.filter((o) => o.id !== hero.id).slice(0, 4);
const slots = [
  { o: others[0], x: 120 }, { o: others[1], x: 310 }, { o: hero, x: 500, pick: true }, { o: others[2], x: 690 }, { o: others[3], x: 880 },
].filter((s) => s.o);

// Diagram coordinates (viewBox 1000 x 760). The picked render ends centred at (500, 384), 520 px wide.
const CX = 500, CY = 384, IMG = 520;
const sides: ('l' | 'r')[] = ['l', 'l', 'r', 'r', 'r'];
const tys = [200, 380, 110, 300, 490];
const anchors = [[450, 300], [440, 400], [560, 320], [555, 420], [500, 500]];
const items = knownItems(hero).slice(0, 5).map((it, i) => {
  const side = sides[i], tagX = side === 'l' ? 20 : 690, edge = side === 'l' ? tagX + 300 : tagX, ty = tys[i];
  const fx = tagX + 4 + 30, fy = ty + 34; // centre of the little picture slot inside the tag
  const stub = it.forSale && it.price != null ? (it.price === 0 ? 'Free' : money(it.price)) : examplePrice(it.id);
  return { it, side, tagX, edge, tagY: ty, ey: ty + 34, ax: anchors[i][0], ay: anchors[i][1], dx: fx - CX, dy: fy - CY, stub, off: !it.forSale || it.limited };
});
const total = buyNow(hero);
const flag = (i: (typeof items)[number]) => (!i.it.forSale ? ' · off sale' : i.it.limited ? ' · limited' : '');
---
<section class="scene" id="rail" data-step="1" data-scene data-phases="0 .06 .35 .67 .9 1" aria-labelledby="rail-h">
  <div class="stage">
    <header class="caps">
      <span class="kicker">The outfit rail</span>
      <h2 id="rail-h">Pick a fit.</h2>
      <p class="cap" data-n="1">From {star.displayName}’s saved outfits. Scroll to take one off the rail.</p>
      <p class="cap" data-n="2"><b>{hero.name}</b><span>{hero.assets.length} pieces make up this saved look.</span></p>
      <p class="cap" data-n="3"><b>See what makes the fit.</b><span>Find the creator, price, and availability for each piece shown.</span></p>
      <p class="cap" data-n="4"><b>See what’s for sale.</b><span>The total covers items for sale.</span></p>
      <ol class="steps" aria-hidden="true">
        <li>Rail</li><li>Outfit</li><li>Pieces</li><li>Total</li>
      </ol>
    </header>

    <div class="visual">
    <svg class="art" viewBox="0 0 1000 760" role="img" aria-label={`${hero.name}, a saved outfit by ${star.displayName}, lifted from a rail and pulled apart into its ${items.length} items.`} preserveAspectRatio="xMidYMid meet">
      <defs>
        <radialGradient id="rail-floor"><stop stop-color="currentColor" stop-opacity=".13" /><stop offset="1" stop-color="currentColor" stop-opacity="0" /></radialGradient>
      </defs>
      <ellipse class="floor-light" cx="500" cy="594" rx="315" ry="105" fill="url(#rail-floor)" />
      <g class="railg">
        <rect x="30" y="52" width="940" height="7" rx="3.5" fill="var(--steel)" />
        <rect x="24" y="44" width="10" height="24" rx="3" fill="var(--steel-dark)" /><rect x="966" y="44" width="10" height="24" rx="3" fill="var(--steel-dark)" />
        {slots.map((s, i) => (
          <g class={'hang' + (s.pick ? ' picked' : '')} style={`--i:${i}`} transform={`translate(${s.x} 0)`}>
            <g class="sway">
              <g transform="translate(-12 58) scale(1)" fill="none" stroke="var(--wood)" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 10.5V9.5a2.5 2.5 0 1 0-2.5-2.5" transform="translate(0 -6)" /><path d="M12 10.5 3 17a1.3 1.3 0 0 0 .8 2.4h16.4A1.3 1.3 0 0 0 21 17l-9-6.5Z" transform="translate(0 -6)" /></g>
              {!s.pick && <image href={s.o.thumb} x="-80" y="72" width="160" height="160" />}
              <text x="0" y={s.pick ? 285 : 252} text-anchor="middle" class="nm">{s.o.name}</text>
            </g>
          </g>
        ))}
      </g>

      <!-- the picked outfit travelling from its hanger to the middle -->
      <g class="mover">
        <g class="fig">
          <ellipse cx={CX} cy={CY + IMG / 2 - 8} rx="110" ry="12" fill="#000" opacity=".14" class="shadow" />
          <image class="body" href={hero.thumb} x={CX - IMG / 2} y={CY - IMG / 2} width={IMG} height={IMG} />
        </g>
      </g>

      <!-- callouts -->
      {items.map((l, i) => (
        <g class="call" style={`--i:${i}`}>
          <path class="ln" pathLength="1" d={`M ${l.ax} ${l.ay} L ${l.edge} ${l.ey}`} />
          <circle class="dot" cx={l.ax} cy={l.ay} r="5" />
          <foreignObject x={l.tagX} y={l.tagY} width="300" height="76">
            <div class={'dtag tag' + (l.off ? ' alert' : '')} xmlns="http://www.w3.org/1999/xhtml">
              <span class="slot"></span>
              <span class="nm2"><b>{l.it.name}</b><small>{l.it.creator?.name ?? 'Unknown creator'}{flag(l)}</small></span>
              <span class="stub num">{l.stub}</span>
            </div>
          </foreignObject>
        </g>
      ))}
      <!-- the pieces fly out of the render and land in their tags -->
      {items.map((l, i) => (
        <image class="fly" href={l.it.thumb!} x={CX - 30} y={CY - 30} width="60" height="60" style={`--dx:${l.dx};--dy:${l.dy}`} />
      ))}

      <g class="total">
        <foreignObject x="290" y="660" width="420" height="70">
          <div class="dtag tag total-tag" xmlns="http://www.w3.org/1999/xhtml">
            <span class="nm2"><b>For-sale total</b><small>{items.length} of {hero.assets.length} pieces shown</small></span>
            <span class="stub num">{money(total)}</span>
          </div>
        </foreignObject>
      </g>
    </svg>
    </div>

    <ul class="mlist" aria-label="Pieces in this outfit">
      {items.map((l, i) => (
        <li style={`--i:${i}`}><span class="th"><img src={l.it.thumb!} alt="" width="44" height="44" loading="lazy" /></span><span><b>{l.it.name}</b><small>{l.it.creator?.name ?? 'Unknown creator'}{flag(l)}</small></span><em class="num">{l.stub}</em></li>
      ))}
      <li class="mtotal"><span><b>For-sale total</b><small>Snapshot prices</small></span><em class="num">{money(total)}</em></li>
    </ul>
  </div>
</section>

<style>
  .scene { position: relative; height: 215svh; --p2: 0; --p3: 0; --p4: 0; }
  .stage { position: sticky; top: 0; min-width: 0; height: 100svh; max-width: 1536px; margin-inline: auto; display: grid; grid-template-columns: minmax(190px, 1fr) minmax(0, 4fr); align-items: center; gap: clamp(16px, 3vw, 48px); padding: calc(var(--nav-h) + 16px) var(--gutter) 16px; }
  .caps { display: grid; align-content: center; gap: 12px; min-width: 0; }
  .kicker { color: var(--ink-2); font-size: .7rem; letter-spacing: .13em; font-weight: 800; text-transform: uppercase; }
  h2 { font-size: clamp(2.15rem, 4.3vw, 4.35rem); letter-spacing: -.05em; line-height: 1; text-wrap: initial; }
  .cap { display: none; min-height: 4em; margin: 0; color: var(--ink-2); font-size: clamp(.86rem, 1.35vw, 1rem); line-height: 1.45; }
  .cap b { display: block; color: var(--ink); }
  .scene[data-step='1'] .cap[data-n='1'], .scene[data-step='2'] .cap[data-n='2'], .scene[data-step='3'] .cap[data-n='3'], .scene[data-step='4'] .cap[data-n='4'], .scene[data-step='5'] .cap[data-n='4'] { display: block; }
  .steps { display: grid; gap: 7px; list-style: none; margin: 5px 0 0; padding: 0; color: var(--ink-2); font-size: .78rem; }
  .steps li { display: flex; align-items: center; gap: 9px; }
  .steps li::before { content: ''; width: 14px; height: 1px; background: currentColor; }
  .scene[data-step='1'] .steps li:nth-child(1), .scene[data-step='2'] .steps li:nth-child(2), .scene[data-step='3'] .steps li:nth-child(3), .scene[data-step='4'] .steps li:nth-child(4), .scene[data-step='5'] .steps li:nth-child(4) { color: var(--ink); font-weight: 800; }

  .visual { position: relative; min-width: 0; min-height: 0; height: 100%; }
  .art { display: block; width: 100%; height: 100%; }
  .floor-light { color: var(--ink); opacity: var(--p2); }
  .railg { transform: translateY(calc((1 - var(--p2)) * 168px)); }
  .nm { font-family: var(--f-body); font-weight: 700; font-size: 17px; fill: var(--ink-2); }
  .picked .nm { fill: var(--ink); }
  .sway { transform-origin: 0 58px; animation: sway 5.5s ease-in-out infinite; animation-delay: calc(var(--i) * -1.1s); }
  @keyframes sway { 0%, 100% { transform: rotate(-1.6deg); } 50% { transform: rotate(1.6deg); } }
  :global(html:not([data-motion='full'])) .sway { animation: none; }
  .picked .nm { opacity: calc(1 - var(--p2)); }
  .hang:not(.picked) { opacity: calc(1 - var(--p2) * .62 - var(--p3) * .38); }

  /* Move the featured outfit from the rail to the center of the item diagram. */
  .mover { transform-box: view-box; }
  .fig { transform-box: view-box; transform-origin: 500px 384px; }
  .mover { transform: translateY(calc((1 - var(--p2)) * -12px)); }
  .mover .fig { scale: calc(.47 + .53 * var(--p2)); }
  .shadow { opacity: calc(.14 * var(--p2)); }
  .mover .body { opacity: calc(1 - var(--p3) * .25); }
  .fly { opacity: var(--p3); transform: translate(calc(var(--p3) * var(--dx) * 1px), calc(var(--p3) * var(--dy) * 1px)) scale(calc(.55 + .45 * var(--p3))); transform-box: fill-box; transform-origin: center; filter: drop-shadow(0 4px 8px rgb(15 17 30 / .22)); }

  .call .ln { fill: none; stroke: var(--ink); stroke-width: 1.6; stroke-dasharray: 1; stroke-dashoffset: calc(1 - var(--p3)); opacity: .55; }
  .call .dot { fill: var(--ink); opacity: var(--p3); }
  .call foreignObject { opacity: var(--p3); transform: translateY(calc((1 - var(--p3)) * 14px)); }
  .total foreignObject { opacity: var(--p4); transform: translateY(calc((1 - var(--p4)) * 16px)) scale(calc(.94 + .06 * var(--p4))); transform-origin: center; }

  .dtag { display: grid; grid-auto-flow: column; grid-template-columns: 1fr auto; align-items: stretch; border-radius: 10px; background: var(--paper); box-shadow: 0 1px 0 var(--line), 0 8px 20px rgb(15 17 30 / .12); overflow: hidden; font-family: var(--f-body); color: var(--ink); height: 68px; }
  .dtag { grid-template-columns: auto 1fr auto; }
  .dtag .slot { display: block; width: 68px; background: #eef0f5; }
  .dtag .nm2 { display: grid; align-content: center; padding: 0 12px 0 4px; min-width: 0; line-height: 1.25; }
  .total-tag .nm2 { padding-left: 16px; }
  .dtag b { font-size: 16px; font-weight: 800; display: -webkit-box; -webkit-box-orient: vertical; -webkit-line-clamp: 2; overflow: hidden; }
  .dtag small { font-size: 13px; color: var(--ink-3); white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
  .dtag .stub { display: grid; place-items: center; padding: 0 8px; min-width: 88px; align-content: center; font-size: 17px; font-weight: 800; background: var(--ink); color: var(--wall); }
  .dtag.alert .stub { background: var(--alert); color: #1b1200; font-size: 14px; }
  .stub small { color: inherit; font-size: 12px; }
  .total-tag .stub { background: var(--ink); color: var(--wall); font-size: 22px; }

  .mlist { position: absolute; width: 1px; height: 1px; overflow: hidden; clip-path: inset(50%); white-space: nowrap; }

  /* Keep the completed illustration available without motion. */
  .scene.static, :global(html:not(.js)) .scene { height: auto; }
  .scene.static .stage, :global(html:not(.js)) .stage { position: relative; height: auto; }
  .scene.static .visual, :global(html:not(.js)) .visual { height: auto; aspect-ratio: 1000 / 760; }
  .scene.static .steps, :global(html:not(.js)) .steps { display: none; }
  :global(html:not(.js)) .scene { --p1: 1; --p2: 1; --p3: 1; --p4: 1; }
  :global(html:not(.js)) .scene[data-step='1'] .cap[data-n='1'] { display: none; }
  :global(html:not(.js)) .cap[data-n='4'] { display: block; }

  @media (max-width: 800px) {
    .stage { display: flex; flex-direction: column; align-items: stretch; gap: 8px; }
    .caps { gap: 5px; }
    .cap { min-height: 2.9em; max-width: 46ch; }
    .cap b { display: inline; margin-right: .35em; }
    .steps { display: flex; gap: 11px; margin-top: 2px; }
    .steps li { gap: 4px; }
    .steps li::before { width: 8px; }
    .visual { flex: 0 0 auto; height: clamp(136px, calc(56svh - 33svh * var(--p3)), 440px); }
    .visual { overflow: clip; }
    .art { transform: scale(calc(1.65 - .65 * var(--p2))); }
    .hang:first-of-type, .hang:last-of-type { display: none; }
    .nm { font-size: 19px; }
    .call, .total, .fly { display: none; }
    .mlist { position: relative; width: min(100%, 560px); align-self: center; height: auto; min-height: 0; overflow: auto; clip-path: none; white-space: normal; display: grid; gap: 5px; list-style: none; margin: 0; padding: 0; opacity: var(--p3); }
    :global(html.js) .scene[data-step='1'] .mlist, :global(html.js) .scene[data-step='2'] .mlist { visibility: hidden; }
    .mlist li { display: grid; grid-template-columns: 38px minmax(0, 1fr) auto; gap: 8px; align-items: center; background: var(--paper); border-radius: 8px; padding: 4px 8px; }
    .mlist .th { border-radius: 6px; height: 38px; overflow: hidden; background: #eef0f5; }
    .mlist img { width: 100%; height: 100%; object-fit: contain; }
    .mlist b { display: block; font-size: .8rem; line-height: 1.2; overflow-wrap: anywhere; }
    .mlist small { display: block; color: var(--ink-2); font-size: .7rem; }
    .mlist em { font-style: normal; font-weight: 800; font-size: .8rem; text-align: right; }
    .mlist .mtotal { grid-template-columns: minmax(0, 1fr) auto; padding: 8px; background: var(--paper); color: var(--ink); border: 1px solid var(--line); }
    .mlist .mtotal small { color: var(--ink-2); }
    .scene.static .visual, :global(html:not(.js)) .visual { height: clamp(136px, 36svh, 300px); }
    .scene.static .mlist, :global(html:not(.js)) .mlist { visibility: visible; opacity: 1; }
  }
</style>
