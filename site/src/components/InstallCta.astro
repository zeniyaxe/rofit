---
import { LINKS, BROWSERS } from '../config';
const live = !!LINKS.chromeStore;
---
<section class="cta" aria-labelledby="cta-h">
  <div class="inner rv">
    <h2 id="cta-h">Open the curtain on any profile.</h2>
    <p>
      {live
        ? 'Free, no account.'
        : 'RoFit isn’t on the Chrome Web Store yet. Until it is, you can load it yourself in a couple of minutes, from the source.'}
    </p>
    <div class="row">
      <a class="btn btn-white" href="/install">{live ? 'Add to Chrome' : 'How to install it today'}</a>
      <a class="btn btn-ghost" href="#demo">Try the demo again</a>
      {LINKS.donate && <a class="btn btn-ghost" href={LINKS.donate} rel="noopener">Donate</a>}
    </div>
    <p class="small">{BROWSERS.chrome.name} and other Chromium browsers. Firefox isn’t supported yet.</p>
  </div>
</section>

<style>
  .cta { width: min(100%, calc(var(--maxw) + var(--gutter) * 2)); margin: clamp(90px, 14vw, 180px) auto 0; padding: 0 var(--gutter); }
  .inner { position: relative; overflow: hidden; border-radius: 22px; background: var(--curtain); color: var(--on-curtain); padding: clamp(36px, 7vw, 96px) clamp(24px, 6vw, 80px); }
  .inner::before { content: ''; position: absolute; inset: 0; background: repeating-linear-gradient(90deg, rgb(0 0 40 / .22) 0 2px, transparent 2px 15px, rgb(255 255 255 / .06) 15px 19px, transparent 19px 38px); }
  .inner > * { position: relative; }
  h2 { font-size: clamp(2rem, 5vw, 4.4rem); letter-spacing: -.04em; max-width: 14ch; }
  p { margin-top: 18px; color: var(--on-curtain-2); max-width: 52ch; }
  .row { display: flex; flex-wrap: wrap; gap: 12px; margin-top: 28px; }
  .small { font-size: 14px; margin-top: 20px; }
</style>
