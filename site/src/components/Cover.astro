---
import { coverLooks, priceOf, kindOf, money, capturedLabel } from '../lib/real';
// The stage keeps a fixed 21:10 aspect and the render is its centred square, so the leader lines can live in one
// uniform coordinate space (0–210 × 0–100) and never distort.
const W = 210, H = 100;
// Roblox renders carry generous padding, so the figure is drawn larger than its square (S, from the centre) and the
// lines aim at the scaled positions.
const S = 1.3;
const ix = (ax: number) => W / 2 + (ax - .5) * H * S;   // image fraction → stage units
const iy = (ay: number) => H / 2 + (ay - .5) * H * S;
const COL = 147;                                    // where the cover lines start (70% of the stage)
---
<section class="cover field" id="top" aria-labelledby="cover-h">
  <p class="mast" aria-hidden="true"><span>RoFit</span></p>

  <div class="spread wrap">
    <div class="copy">
      <h1 id="cover-h">Get the look.</h1>
      <p class="deck">RoFit opens the outfits Roblox players save and names every piece: what it is, who made it, what it costs today, and whether you can still buy it.</p>
      <div class="acts">
        <a class="btn" href="/download">Install RoFit<svg class="go" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6" /></svg></a>
        <a class="btn line" href="#try">Try it live<svg class="down" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 5v14M6 13l6 6 6-6" /></svg></a>
      </div>
      <p class="meta">Free · Chrome, Edge and Brave · Nothing collected</p>
    </div>

    <div class="stage" id="cover-stage" role="group" aria-roledescription="carousel" aria-label="Real saved outfits, called out piece by piece">
      {coverLooks.map((look, n) => (
        <figure class="look" data-on={n === 0 ? '' : undefined} aria-hidden={n === 0 ? undefined : 'true'} id={`look-${n}`} aria-roledescription="slide" aria-label={`${n + 1} of ${coverLooks.length}: ${look.outfit.name}`}>
          <svg class="leaders" viewBox={`0 0 ${W} ${H}`} aria-hidden="true">
            {look.calls.map((c, k) => {
              const x1 = ix(c.ax), y1 = iy(c.ay), y0 = c.ly * H, elbow = COL - 6;
              return <path d={`M${COL - 1} ${y0} H${elbow} L${x1} ${y1}`} pathLength="1" style={`--k:${k}`} data-k={k} />;
            })}
          </svg>
          <div class="fig">
            <img src={n === 0 ? look.outfit.thumb : undefined} data-src={look.outfit.thumb} alt={`${look.outfit.name}, an outfit ${look.owner.displayName} saved on Roblox`} width="420" height="420" loading={n === 0 ? 'eager' : 'lazy'} fetchpriority={n === 0 ? 'high' : 'auto'} decoding="async" />
            {look.calls.map((c, k) => <span class="pin" style={`--x:${c.ax * 100}%;--y:${c.ay * 100}%;--k:${k}`} data-k={k} aria-hidden="true"><i>{k + 1}</i></span>)}
          </div>
          <ol class="calls" aria-label={`Pieces in ${look.outfit.name}`}>
            {look.calls.map((c, k) => {
              const p = priceOf(c.item);
              return (
                <li class="call" style={`--ly:${c.ly * 100}%;--k:${k}`} data-k={k}>
                  <span class="n" aria-hidden="true">{k + 1}</span>
                  <b>{c.item.name}</b>
                  <span class="sub">{kindOf(c.item.typeName)}{c.item.creator ? ` · ${c.item.creator.name}` : ''}</span>
                  <span class="tags">{c.item.limited && <span class="ltd">Limited</span>}<span class={'price ' + p.tone} aria-label={p.aria}>{p.text}</span></span>
                </li>
              );
            })}
          </ol>
          <figcaption class="stamp">
            <span class="no">{look.outfit.id}</span>
            <b>{look.outfit.name}</b>
            <span>Saved by {look.owner.displayName}{look.outfit.avatarType ? ` · ${look.outfit.avatarType}` : ''} · {look.outfit.assets.length} pieces · as seen {capturedLabel.replace(/ /g, ' ')}</span>
            <span class="total">For sale new <strong class="num">{look.buyNow ? money(look.buyNow) : 'nothing'}</strong>{look.offSale > 0 && <> · {look.offSale} off sale</>}{look.unknown > 0 && <> · {look.unknown} unknown</>}</span>
          </figcaption>
        </figure>
      ))}
      <div class="switch">
        <button type="button" class="prev" aria-controls="cover-stage" aria-label="Previous outfit"><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M15 6l-6 6 6 6" /></svg></button>
        <span class="count num" aria-live="polite"><b>1</b> / {coverLooks.length}</span>
        <button type="button" class="next" aria-controls="cover-stage" aria-label="Next outfit"><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M9 6l6 6-6 6" /></svg></button>
      </div>
    </div>
    <p class="source">Real public profiles, as a signed-out visitor saw them on {capturedLabel}. Prices are Roblox’s own; callouts point to where each kind of item is worn.</p>
  </div>
</section>

<style>
  .cover { position: relative; overflow: clip; padding-top: var(--nav-h); --mast: clamp(6rem, 21.5vw, 26rem); }
  /* the masthead: the issue's name, set to the width of the page */
  .mast { position: relative; z-index: 0; margin: 0; padding: clamp(6px, 1vw, 14px) var(--gutter) 0; font-family: var(--f-display); font-weight: 900; font-stretch: 150%;
    font-size: var(--mast); line-height: .72; letter-spacing: -.05em; text-transform: uppercase; white-space: nowrap; user-select: none; }
  .mast span { display: block; transform-origin: 0 0; }
  @supports (animation-timeline: scroll()) {
    :root[data-motion='full'] .mast span { animation: mast-lift linear both; animation-timeline: scroll(root); animation-range: 0 80vh; }
    @keyframes mast-lift { to { transform: translateY(-10%) scale(.96); opacity: .3; } }
  }

  .spread { position: relative; z-index: 1; display: grid; grid-template-areas: 'stage'; padding-bottom: clamp(20px, 3vw, 40px); }
  .source { position: relative; z-index: 2; }
  .stage { grid-area: stage; position: relative; width: min(100%, calc(min(80svh, 780px) * 2.1)); aspect-ratio: 2.1; justify-self: center; margin-top: calc(var(--mast) * -.4); }
  .copy { grid-area: stage; align-self: end; justify-self: start; z-index: 3; width: min(31%, 430px); }
  h1 { font-size: clamp(2.8rem, 4.8vw, 5rem); font-stretch: var(--narrow); font-weight: 900; line-height: .88; letter-spacing: -.02em; text-transform: uppercase; }
  .deck { margin-top: var(--s4); font-size: var(--t-lead); line-height: 1.5; max-width: 36ch; }
  .acts { display: flex; flex-wrap: wrap; gap: var(--s3); margin-top: var(--s5); }
  .meta { margin-top: var(--s4); font-size: var(--t-small); font-weight: 600; }

  .look { position: absolute; inset: 0; margin: 0; pointer-events: none; visibility: hidden; transition: visibility 0s linear var(--d-slow); }
  .look[data-on] { pointer-events: auto; visibility: visible; transition-delay: 0s; }
  .fig { position: absolute; left: 50%; top: 0; height: 100%; aspect-ratio: 1; transform: translateX(-50%) scale(1.3); }
  .fig img { width: 100%; height: 100%; object-fit: contain; filter: drop-shadow(0 28px 24px rgb(80 0 30 / .3));
    opacity: 0; transform: translateY(var(--deal)) rotate(var(--tilt)) scale(.96); transition: opacity var(--d) var(--ease), transform var(--d-slow) var(--ease); }
  .look[data-on] .fig img { opacity: 1; transform: none; transition: opacity var(--d-slow) var(--ease) 60ms, transform calc(var(--d-slow) * 1.3) var(--land) 30ms; }
  .look.leaving .fig img { transform: translateY(calc(var(--deal) * -.4)) rotate(calc(var(--tilt) * -1)) scale(.96); }

  /* leader lines run behind the figure and surface on the item's pin */
  .leaders { position: absolute; inset: 0; width: 100%; height: 100%; overflow: visible; }
  .leaders path { fill: none; stroke: var(--spot-ink); stroke-width: .16; stroke-linecap: round; stroke-dasharray: 1 1; stroke-dashoffset: 1; transition: stroke-dashoffset var(--d) var(--ease-in), opacity var(--d-fast); }
  .look[data-on] .leaders path { stroke-dashoffset: 0; transition: stroke-dashoffset var(--d-slow) var(--ease) calc(240ms + var(--k) * 70ms), opacity var(--d-fast); }
  .pin { position: absolute; left: var(--x); top: var(--y); width: 11px; height: 11px; margin: -5.5px 0 0 -5.5px; border-radius: 50%; background: var(--spot-ink); box-shadow: 0 0 0 3px var(--spot);
    opacity: 0; transform: scale(.3); transition: opacity var(--d-fast), transform var(--d) var(--land); }
  .pin i { display: none; }
  .look[data-on] .pin { opacity: 1; transform: none; transition-delay: calc(200ms + var(--k) * 70ms); }

  .calls { list-style: none; position: absolute; left: 70%; right: 0; top: 0; bottom: 0; }
  .call { position: absolute; left: 0; right: 0; top: var(--ly); transform: translateY(-1.15em); display: grid; gap: 1px; font-size: var(--t-small); line-height: 1.3;
    opacity: 0; translate: calc(var(--rise) * .6) 0; transition: opacity var(--d-fast) var(--ease), translate var(--d) var(--ease); }
  .look[data-on] .call { opacity: 1; translate: none; transition: opacity var(--d) var(--ease) calc(320ms + var(--k) * 70ms), translate var(--d-slow) var(--ease) calc(320ms + var(--k) * 70ms); }
  .call b { font-weight: 760; font-size: var(--t-ui-l); display: -webkit-box; -webkit-line-clamp: 1; -webkit-box-orient: vertical; overflow: hidden; }
  .call .sub { color: var(--ink-2); font-size: var(--t-small); white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
  .call .tags { display: inline-flex; align-items: center; gap: 6px; margin-top: 4px; }
  .call .n { display: none; }
  .look:has(.call:hover) .leaders path, .look:has(.call:hover) .pin { opacity: .2; }
  .look:has(.call[data-k='0']:hover) [data-k='0'], .look:has(.call[data-k='1']:hover) [data-k='1'], .look:has(.call[data-k='2']:hover) [data-k='2'],
  .look:has(.call[data-k='3']:hover) [data-k='3'], .look:has(.call[data-k='4']:hover) [data-k='4'] { opacity: 1; }

  /* issue line: the collector number and whose wardrobe this is, under the masthead */
  .stamp { position: absolute; left: 0; top: calc(var(--mast) * .5); width: min(30%, 400px); display: grid; gap: 2px; font-size: var(--t-small); line-height: 1.35;
    opacity: 0; translate: 0 calc(var(--nudge) * 1.5); transition: opacity var(--d-fast), translate var(--d) var(--ease); }
  .look[data-on] .stamp { opacity: 1; translate: none; transition: opacity var(--d-slow) var(--ease) 160ms, translate var(--d-slow) var(--ease) 160ms; }
  .stamp b { font-family: var(--f-display); font-stretch: var(--cond); font-weight: 840; font-size: var(--t-h4); line-height: 1; letter-spacing: -.01em; margin: 4px 0 2px; }
  .stamp .total { margin-top: 2px; }
  .stamp .total strong { font-family: var(--f-display); font-stretch: var(--wide); font-weight: 760; }

  .switch { position: absolute; left: 70%; bottom: 0; display: flex; align-items: center; gap: 4px; z-index: 3; }
  .switch button { width: 48px; height: 48px; display: grid; place-items: center; border-radius: var(--r-sm); box-shadow: inset 0 0 0 1.5px var(--spot-ink); transition: background var(--d-fast), color var(--d-fast), transform var(--d) var(--land); }
  .switch button:hover { background: var(--spot-ink); color: var(--spot); }
  .switch button:active { transform: scale(.93); transition-duration: 70ms; }
  .count { min-width: 66px; text-align: center; font-family: var(--f-display); font-stretch: var(--wide); font-weight: 620; font-size: var(--t-small); }
  .source { grid-column: 1 / -1; margin-top: var(--s4); font-size: var(--t-micro); color: var(--ink-2); max-width: 70ch; }

  /* ---- narrower than a spread: stack it, number the pins, list the pieces ----------------------------------- */
  @media (max-width: 1100px) {
    .cover { --mast: clamp(3.4rem, 20.5vw, 18rem); }
    .spread { grid-template-areas: 'copy' 'stage'; row-gap: var(--s4); }
    .copy { grid-area: copy; width: auto; max-width: 40rem; margin-top: var(--s4); }
    .deck { font-size: .98rem; }
    h1 { font-size: clamp(2.6rem, 11vw, 4.6rem); }
    .stage { grid-area: stage; width: 100%; aspect-ratio: auto; margin-top: 0; display: grid; }
    .look { position: relative; inset: auto; grid-area: 1 / 1; display: grid; grid-template-columns: minmax(0, 1fr); }
    .look:not([data-on]) { display: none; }
    .stamp { position: relative; left: auto; top: auto; width: auto; order: 1; margin-top: var(--s3); padding-top: var(--s3); border-top: 1.5px solid var(--spot-ink); }
    .calls { order: 2; }
    .fig { position: relative; left: auto; transform: scale(1.12); width: min(100%, 400px); height: auto; justify-self: center; margin-block: 2%; }
    .leaders { display: none; }
    .pin { width: 22px; height: 22px; margin: -11px 0 0 -11px; display: grid; place-items: center; box-shadow: 0 0 0 2px var(--spot); }
    .pin i { display: block; font-style: normal; font-size: var(--t-micro); font-weight: 800; color: var(--spot); }
    .calls { position: static; display: grid; grid-template-columns: repeat(auto-fill, minmax(min(100%, 250px), 1fr)); gap: var(--s4) var(--s5); margin-top: var(--s5); }
    .call { position: relative; top: auto; transform: none; grid-template-columns: 26px minmax(0, 1fr); column-gap: 10px; padding-top: 10px; border-top: 1px solid var(--rule); }
    .call > :not(.n) { grid-column: 2; }
    .call b { -webkit-line-clamp: 2; }
    .call .n { display: grid; grid-row: 1 / span 3; place-items: center; width: 22px; height: 22px; border-radius: 50%; background: var(--spot-ink); color: var(--spot); font-size: var(--t-micro); font-weight: 800; margin-top: 1px; }
    .switch { position: relative; left: auto; bottom: auto; justify-self: start; margin-top: var(--s5); grid-area: 2 / 1; }
  }
</style>

<script>
  const stage = document.getElementById('cover-stage');
  if (stage) {
    const looks = [...stage.querySelectorAll<HTMLElement>('.look')];
    const count = stage.querySelector('.count b')!;
    let at = 0;
    const timers = new WeakMap<HTMLElement, number>();
    // CSS transitions do the motion, so a click mid-flight simply retargets: nothing snaps, nothing is left half-drawn.
    const show = (n: number) => {
      const next = (n + looks.length) % looks.length;
      if (next === at) return;
      const prev = looks[at], el = looks[next];
      prev.classList.add('leaving'); prev.removeAttribute('data-on'); prev.setAttribute('aria-hidden', 'true');
      clearTimeout(timers.get(prev)); timers.set(prev, window.setTimeout(() => prev.classList.remove('leaving'), 700));
      el.classList.remove('leaving'); warm(next);
      el.setAttribute('data-on', ''); el.removeAttribute('aria-hidden');
      at = next; count.textContent = String(at + 1);
      warm(at + 1);
    };
    stage.querySelector('.prev')!.addEventListener('click', () => show(at - 1));
    stage.querySelector('.next')!.addEventListener('click', () => show(at + 1));
    stage.addEventListener('keydown', (e) => {
      if (e.key === 'ArrowRight') { e.preventDefault(); show(at + 1); }
      if (e.key === 'ArrowLeft') { e.preventDefault(); show(at - 1); }
    });
    // Swipe on touch: horizontal intent only, so vertical scrolling is never hijacked.
    let x0 = 0, y0 = 0, tracking = false;
    stage.addEventListener('pointerdown', (e) => { if (e.pointerType !== 'mouse') { x0 = e.clientX; y0 = e.clientY; tracking = true; } });
    stage.addEventListener('pointercancel', () => { tracking = false; });
    stage.addEventListener('pointerup', (e) => {
      if (!tracking) return; tracking = false;
      const dx = e.clientX - x0, dy = e.clientY - y0;
      if (Math.abs(dx) > 48 && Math.abs(dx) > Math.abs(dy) * 1.5) show(at + (dx < 0 ? 1 : -1));
    });
    // Only the next look is fetched ahead (once idle, then after each switch): switching never waits on the network,
    // and visitors who never switch don't download five renders.
    // Hidden slides carry their render in data-src, because browsers fetch lazy images in hidden-but-placed slides anyway.
    const warm = (n: number) => { const img = looks[(n + looks.length) % looks.length].querySelector('img'); if (img && !img.getAttribute('src')) img.src = img.dataset.src!; };
    const idle = (window as any).requestIdleCallback ?? ((f: () => void) => setTimeout(f, 1200));
    idle(() => warm(1));
    stage.addEventListener('pointerenter', () => warm(at - 1), { once: true });
  }
</script>
