---
import { star, capturedLabel } from '../lib/real';
---
<section class="demo" id="demo" data-start={star.id} aria-labelledby="demo-h">
  <div class="head">
    <h2 id="demo-h">Try it. This is the real thing.</h2>
    <p>This window is RoFit’s actual interface, running on Shedletsky’s public Roblox profile, captured on {capturedLabel}. No Roblox account, nothing to install, nothing sent to Roblox from this page.</p>
  </div>

  <div class="controls" role="group" aria-label="Demo controls">
    <p class="profile"><strong>Shedletsky</strong><span>{star.outfits.length} saved outfits</span></p>
    <div class="tog">
      <button type="button" id="demo-theme" aria-pressed="false">Dark panel</button>
      <button type="button" id="demo-motion" aria-pressed="false">Reduce motion</button>
    </div>
  </div>

  <p class="real">Public profile snapshot from {capturedLabel}. RoFit is independent of Roblox, Shedletsky, and the item creators. <a href="mailto:support@rofit.site">Contact us about this snapshot.</a></p>

  <div class="browser">
    <div class="bar"><i></i><i></i><i></i><span class="url">roblox.com/users/<b id="demo-uid">{star.id}</b>/profile</span></div>
    <div class="view">
      <div id="demo-host" class="host" aria-label="RoFit demo"></div>
      <div class="boot" id="demo-boot" role="status">Loading the demo…</div>
      <noscript><p class="ns">The live demo needs JavaScript. Everything else on this site works without it.</p></noscript>
    </div>
  </div>
  <p class="dnote">Item links open the real Roblox catalog page.</p>
</section>

<style>
  .demo { width: min(100%, calc(var(--maxw) + var(--gutter) * 2)); margin: clamp(90px, 14vw, 180px) auto 0; padding: 0 var(--gutter); }
  .head { max-width: 68ch; margin-inline: auto; text-align: center; }
  h2 { font-size: clamp(2rem, 4.2vw, 4rem); letter-spacing: -.035em; }
  .head p { margin-top: 16px; color: var(--ink-2); }
  .controls { display: flex; flex-wrap: wrap; gap: 14px 24px; justify-content: center; align-items: center; margin: 28px 0 14px; }
  .tog, .profile { display: flex; flex-wrap: wrap; align-items: center; justify-content: center; gap: 8px; }
  .profile { margin: 0; }
  .profile span { font-size: 14px; color: var(--ink-3); }
  .tog button { padding: 8px 14px; min-height: 40px; border-radius: 10px; font-weight: 700; font-size: 14px; box-shadow: inset 0 0 0 1.5px var(--line); transition: background .2s, transform .15s; }
  .tog button[aria-pressed='true'] { background: var(--ink); color: var(--wall); box-shadow: none; }
  .tog button:active { transform: scale(.96); }

  .browser { border-radius: 14px; background: var(--paper); box-shadow: 0 0 0 1px var(--line), 0 40px 80px rgb(15 20 60 / .18); overflow: hidden; }
  .bar { display: flex; align-items: center; gap: 7px; padding: 11px 14px; background: var(--wall-2); }
  .bar i { width: 11px; height: 11px; border-radius: 50%; background: var(--steel); opacity: .6; }
  .url { margin-left: 10px; flex: 1; min-width: 0; padding: 5px 12px; border-radius: 8px; background: var(--paper); font-size: 13px; color: var(--ink-3); white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
  .url b { color: var(--ink); font-weight: 600; }
  .view { position: relative; height: clamp(520px, 78svh, 760px); }
  .host { position: absolute; inset: 0; opacity: 0; transition: opacity .5s var(--ease); }
  .view.ready .host { opacity: 1; }
  .boot { position: absolute; inset: 0; display: grid; place-items: center; color: var(--ink-3); font-weight: 600; transition: opacity .3s; }
  .view.ready .boot { opacity: 0; pointer-events: none; }
  .ns { position: absolute; inset: 0; display: grid; place-items: center; padding: 24px; text-align: center; }
  .real { margin: 0 auto 16px; text-align: center; padding: 12px 16px; border-radius: 12px; background: var(--wall-2); font-size: 14px; color: var(--ink-2); max-width: 78ch; }
  .real[hidden] { display: none; }
  .dnote { margin: 14px auto 0; text-align: center; font-size: 14px; color: var(--ink-3); max-width: 70ch; }
  @media (max-width: 700px) { .view { height: clamp(560px, 80svh, 720px); } .url { font-size: 12px; } }
</style>

<script>
  import { loadDemo } from '../scripts/demo-loader';
  const sec = document.getElementById('demo')!;
  const host = document.getElementById('demo-host')!;
  const view = sec.querySelector('.view')!;
  const boot = document.getElementById('demo-boot')!;
  const themeBtn = document.getElementById('demo-theme') as HTMLButtonElement;
  const motionBtn = document.getElementById('demo-motion') as HTMLButtonElement;
  const state = { userId: Number(sec.dataset.start), theme: 'light' as 'light' | 'dark', reduced: false };
  let handle: { update: (o: typeof state) => void } | null = null;
  let loading: Promise<void> | null = null;

  const load = () => loading ??= (async () => {
    try {
      const mod = await loadDemo();
      handle = await mod.mountDemo(host, state);
      view.classList.add('ready');
    } catch {
      boot.textContent = 'The demo could not load here. The extension itself is unaffected.';
    }
  })();

  // Start fetching the (lazy) bundle when the section is near, not at page load.
  new IntersectionObserver((e, o) => { if (e[0].isIntersecting) { load(); o.disconnect(); } }, { rootMargin: '600px 0px' }).observe(sec);

  const push = () => handle?.update({ ...state });
  themeBtn.addEventListener('click', () => {
    state.theme = state.theme === 'dark' ? 'light' : 'dark';
    themeBtn.setAttribute('aria-pressed', String(state.theme === 'dark'));
    push();
  });
  motionBtn.addEventListener('click', () => {
    state.reduced = !state.reduced;
    motionBtn.setAttribute('aria-pressed', String(state.reduced));
    push();
  });
  // Honour the site-wide reduced-motion choice as the demo's starting point.
  if (document.documentElement.dataset.motion !== 'full') { state.reduced = true; motionBtn.setAttribute('aria-pressed', 'true'); }
</script>
