---
import Hanger from './Hanger.astro';
import { LINKS } from '../config';
import { star, hero as pickO, buyNow, knownItems, money } from '../lib/real';

const others = star.outfits.filter((o) => o.id !== pickO.id).slice(0, 5);
const six = [...others.slice(0, 3), pickO, ...others.slice(3)];
const chosen = 3;
const cost = buyNow(pickO);
const unavailable = pickO.assets.length - knownItems(pickO).filter((item) => item.forSale).length;
---
<section class="stall on-curtain" id="top" aria-labelledby="hero-h">
  <div class="hero-grid wrap">
    <div class="copy">
      <span class="eyebrow">THE ROBLOX OUTFIT BROWSER</span>
      <h1 id="hero-h">See the fit.<br />Know every piece.</h1>
      <p class="lede">Explore saved outfits on public Roblox profiles. See what each look is made of, what’s for sale, and how much it costs.</p>
      <div class="actions">
        <a class="btn btn-white" href="#demo">Try the live demo
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 5v14M6 13l6 6 6-6" /></svg>
        </a>
        <a class="btn btn-ghost" href="/install">Install RoFit</a>
      </div>
      <p class="status">
        {LINKS.chromeStore ? 'Available for Chrome.' : 'Chrome and Firefox listings coming soon.'}
        <span> Free · Source on GitHub</span>
      </p>
    </div>

    <div class="mirror" id="mirror">
      <div class="frame" aria-hidden="true">
        <div class="glass">
          <div class="pf">
            <div class="pf-head">
              {star.headshot && <img class="pf-av" src={star.headshot} alt="" width="56" height="56" />}
              <div><b>{star.displayName}</b><small>@{star.name}</small></div>
            </div>
            <div class="pf-tabs" role="presentation">
              <span class="t-out" id="t-out"><Hanger size={16} /> Outfits</span>
              <span class="count">{star.outfits.length} saved looks</span>
            </div>
            <div class="pf-grid">
              {six.map((o, i) => (
                <div class={'tile' + (i === chosen ? ' pick' : '')}>
                  <span class="fig"><img src={o.thumb} alt="" width="140" height="140" decoding="async" /></span>
                  <b>{o.name}</b>
                </div>
              ))}
            </div>
            <div class="pf-tag"><span>{pickO.assets.length} items</span><span class="num">{money(cost)}{unavailable ? ` · ${unavailable} unavailable` : ''}</span></div>
          </div>
          <svg id="cursor" class="tour-pointer" width="24" height="24" viewBox="0 0 24 24"><path d="M4 3l15 8-7 2-2 7z" fill="#121a32" stroke="#fff" stroke-width="1.5" stroke-linejoin="round"/></svg>
          <span id="ripple" class="tour-ripple"></span>
        </div>
      </div>
    </div>
    <button type="button" class="tour-replay" id="hero-replay" hidden>↻ Replay walkthrough</button>
  </div>
</section>

<style>
  .stall { position: relative; isolation: isolate; overflow: hidden; padding-block: calc(var(--nav-h) + clamp(46px, 7vw, 106px)) clamp(44px, 7vw, 100px); color: #fff; background: #101632; }
  .stall::before { content: ''; position: absolute; inset: 0; z-index: -1; background: radial-gradient(ellipse at 0% 10%, #314ced 0%, transparent 62%), radial-gradient(ellipse at 98% 90%, #283782 0%, transparent 57%); }
  .hero-grid { display: grid; grid-template-columns: minmax(0, .95fr) minmax(0, 1.05fr); align-items: center; gap: clamp(24px, 5vw, 84px); }
  .copy { min-width: 0; }
  .eyebrow { display: inline-block; color: #e1e7ff; font-size: .72rem; font-weight: 800; letter-spacing: .14em; margin-bottom: 16px; }
  h1 { font-size: clamp(2.65rem, 5.3vw, 5.4rem); letter-spacing: -.045em; line-height: 1.04; color: #fff; }
  .lede { margin-top: 18px; max-width: 41ch; font-size: clamp(1.02rem, 1.35vw, 1.26rem); color: #e1e7ff; }
  .actions { display: flex; flex-wrap: wrap; gap: 10px; margin-top: 26px; }
  .status { margin-top: 18px; font-size: .85rem; color: #e1e7ff; font-weight: 650; }
  .status span { font-weight: 500; }
  .mirror { min-width: 0; width: 100%; max-width: 630px; justify-self: center; }
  .frame { border-radius: 22px; padding: clamp(6px, 1vw, 10px); background: linear-gradient(145deg, #e5e9ff, #646fa2 65%, #bac6fa); box-shadow: 0 25px 55px rgb(0 0 20 / .35); }
  .glass { position: relative; container-type: inline-size; border-radius: 14px; overflow: hidden; background: #151a2c; color: #f1f3ff; }
  .pf { padding: clamp(12px, 4.5cqw, 26px); }
  .pf-head { display: flex; align-items: center; gap: 12px; }
  .pf-av { width: clamp(34px, 12cqw, 60px); height: auto; aspect-ratio: 1; border-radius: 50%; background: #222a44; object-fit: cover; }
  .pf-head b { display: block; font-family: var(--f-display); font-size: clamp(1rem, 5.2cqw, 1.65rem); line-height: 1.15; }
  .pf-head small, .count { color: #b6c2df; font-size: clamp(.72rem, 3.2cqw, .91rem); }
  .pf-tabs { display: flex; align-items: center; justify-content: space-between; gap: 8px; margin-top: 14px; border-bottom: 1px solid #37415d; padding: 0 0 8px; }
  .t-out { display: inline-flex; align-items: center; gap: 6px; font-size: .9rem; font-weight: 750; }
  .pf-grid { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: clamp(5px, 2cqw, 12px); margin-top: 10px; }
  .tile { min-width: 0; border-radius: 9px; background: #202840; border: 1px solid transparent; text-align: center; padding: 3px 4px 6px; }
  .tile.pick { background: #293669; border-color: #8397ff; }
  .fig { display: block; }
  .fig img { width: 100%; height: auto; max-height: 116px; aspect-ratio: 1; object-fit: contain; display: block; }
  .tile b { display: block; font-size: clamp(.65rem, 2.8cqw, .85rem); line-height: 1.15; overflow-wrap: anywhere; }
  .pf-tag { display: flex; flex-wrap: wrap; justify-content: space-between; gap: 4px 10px; margin-top: 12px; padding: 8px 10px; border: 1px solid #37415d; border-radius: 8px; font-size: clamp(.7rem, 3cqw, .9rem); color: #e1e7ff; }
  @media (max-width: 760px) {
    .hero-grid { grid-template-columns: minmax(0, 1fr); }
    .copy { max-width: 550px; }
    .mirror { max-width: 550px; }
  }

  .t-out { border-bottom: 2px solid transparent; }
  .tile { transition: opacity .35s, transform .45s var(--ease), background .35s, border-color .35s; }
  .tour-replay { grid-column: 2; justify-self: center; color: #dce3ff; padding: 8px 12px; border: 1px solid #526191; border-radius: 8px; }
  .tour-replay:hover { background: #253461; }
  @media (max-width: 760px) { .tour-replay { grid-column: 1; } }
  .tour-pointer, .tour-ripple { position: absolute; pointer-events: none; opacity: 0; }
  .tour-pointer { z-index: 2; top: 0; left: 0; transform: translate(var(--tx, 60cqw), var(--ty, 26cqw)); transition: transform .52s var(--ease), opacity .25s; }
  .tour-ripple { width: 34px; height: 34px; border: 2px solid #a5b4ff; border-radius: 50%; left: var(--rx); top: var(--ry); }
  :global(html.js[data-motion="full"]) .stall:not(.s5) .tile { opacity: .2; transform: translateY(5px); }
  :global(html.js[data-motion="full"]) .stall:not(.s6) .pick { background: #202840; border-color: transparent; }
  :global(html.js[data-motion="full"]) .stall:not(.s6) .pf-tag { opacity: .48; }
  .stall.s5 .t-out { border-color: #a5b4ff; }
  .stall.s4:not(.s7) .tour-pointer { opacity: 1; }
  .stall.s5 .tour-ripple { animation: tour-tap .6s ease-out both; }
  @keyframes tour-tap {
    from { opacity: 1; transform: translate(-50%, -50%) scale(.4); }
    to { opacity: 0; transform: translate(-50%, -50%) scale(1.45); }
  }
  @media (prefers-reduced-motion: reduce) {
    .tile, .tour-pointer { transition: none; }
    .tour-ripple { animation: none !important; }
  }
</style>

<script>
  import { runHero } from '../scripts/hero';
  runHero();
</script>
