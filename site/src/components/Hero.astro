---
import Hanger from './Hanger.astro';
import { LINKS } from '../config';
import { star, hero as pickO, buyNow, knownItems, money, capturedLabel } from '../lib/real';

const others = star.outfits.filter((o) => o.id !== pickO.id).slice(0, 5);
const six = [...others.slice(0, 3), pickO, ...others.slice(3)];
const chosen = 3;
const cost = buyNow(pickO);
const unavailable = pickO.assets.length - knownItems(pickO).length;
---
<section class="stall on-curtain" id="top" aria-labelledby="hero-h">
  <div class="rail" aria-hidden="true"></div>
  <div class="curtain cl" aria-hidden="true"><div class="rings"></div><div class="cloth"></div></div>
  <div class="curtain cr" aria-hidden="true"><div class="rings"></div><div class="cloth"></div></div>
  <div class="floor" aria-hidden="true"></div>

  <div class="copy">
    <h1 id="hero-h">See the fit.<br />Know every piece.</h1>
    <p class="lede">Open any Roblox profile and RoFit shows the outfits that player saved: every item, what it costs today, what’s gone.</p>
    <div class="actions">
      <a class="btn btn-white" href="#demo">Try it in the mirror
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 5v14M6 13l6 6 6-6" /></svg>
      </a>
      <a class="btn btn-ghost" href="/install">Install RoFit</a>
    </div>
    <p class="status">
      {LINKS.chromeStore ? 'Available for Chrome.' : 'Chrome listing coming soon.'}
      <span> Free · Source on GitHub · Nothing collected</span>
    </p>
    <p class="status disc">Real public profile shown, captured {capturedLabel}. Not affiliated with or endorsed by the player, the item creators or Roblox.
    </p>
  </div>

  <div class="mirror" aria-hidden="true" id="mirror">
    <div class="frame">
      <div class="glass">
        <div class="pf s-profile">
          <div class="pf-head">
            {star.headshot && <img class="pf-av" src={star.headshot} alt="" width="56" height="56" />}
            <div><b>{star.displayName}</b><small>@{star.name} · real public profile</small></div>
          </div>
          <div class="pf-tabs" role="presentation">
            <span class="t-about">About</span>
            <span>Creations</span>
            <span class="t-out" id="t-out"><Hanger size={16} />Outfits</span>
            <i class="t-line" id="t-line"></i>
          </div>
          <div class="pf-grid" id="pf-grid">
            {six.map((o, i) => (
              <div class={'tile' + (i === chosen ? ' pick' : '')} style={`--i:${i}`} data-tile={i}>
                <span class="fig"><img src={o.thumb} alt="" width="140" height="140" decoding="async" /></span>
                <b>{o.name}</b>
              </div>
            ))}
          </div>
          <div class="pf-tag tag" id="pf-tag"><span>{pickO.assets.length} items</span><span class="stub num">{money(cost)}{unavailable ? ` + ${unavailable} unavailable` : ''}</span></div>
        </div>
        <svg class="cursor" id="cursor" width="26" height="26" viewBox="0 0 24 24" aria-hidden="true"><path d="M5 3l14 7-6 2-2 6z" fill="#111" stroke="#fff" stroke-width="1.6" stroke-linejoin="round" /></svg>
        <i class="ripple" id="ripple"></i>
      </div>
    </div>
  </div>
</section>

<style>
  .stall { position: relative; min-height: max(100svh, 700px); overflow: hidden; background: var(--wall); isolation: isolate; }
  .rail { position: absolute; z-index: 6; left: 0; right: 0; top: calc(var(--nav-h) + 6px); height: 7px; background: linear-gradient(180deg, #d5dbea, #8f98ad 60%, #6b7490); box-shadow: 0 2px 6px rgb(0 0 40 / .35); }
  .curtain { position: absolute; z-index: 4; top: calc(var(--nav-h) + 8px); bottom: 0; width: 56vw; transition: transform 1.5s var(--ease); }
  .cl { left: 0; transform-origin: 0 0; }
  .cr { right: 0; transform-origin: 100% 0; }
  .cloth { position: absolute; inset: 0; background:
      repeating-linear-gradient(90deg, rgb(0 0 50 / .30) 0 2px, transparent 2px 13px, rgb(255 255 255 / .09) 13px 18px, transparent 18px 31px),
      repeating-linear-gradient(90deg, rgb(0 0 50 / .12) 0 7px, transparent 7px 23px),
      linear-gradient(180deg, rgb(255 255 255 / .16), transparent 14%, transparent 70%, rgb(0 0 40 / .22)),
      var(--curtain);
    box-shadow: 0 0 50px rgb(5 12 90 / .4); }
  .cl .cloth { border-radius: 0 0 40px 0 / 0 0 22px 0; }
  .cr .cloth { border-radius: 0 0 0 40px / 0 0 0 22px; }
  .rings { position: absolute; z-index: 2; left: 0; right: 0; top: -2px; height: 18px; background: radial-gradient(circle at 50% 50%, transparent 4.2px, #c9d0e2 4.6px 6.2px, transparent 6.6px) 0 0 / 31px 18px repeat-x; filter: drop-shadow(0 1px 1px rgb(0 0 40 / .5)); }
  .floor { position: absolute; z-index: 1; left: 0; right: 0; bottom: 0; height: 12svh; background: var(--wall-3); }
  .floor::before { content: ''; position: absolute; inset: 0 0 auto 0; height: 10px; background: linear-gradient(180deg, rgb(15 17 30 / .14), transparent); }

  .copy { position: absolute; z-index: 7; left: var(--gutter); top: calc(var(--nav-h) + 30px); bottom: 8svh; width: min(43vw, 640px); display: flex; flex-direction: column; justify-content: center; color: #fff; }
  h1 { font-size: clamp(2.3rem, 4.9vw, 4.9rem); letter-spacing: -.035em; line-height: 1; color: #fff; }
  .lede { margin-top: 22px; max-width: 42ch; font-size: clamp(1.02rem, 1.2vw, 1.2rem); color: var(--on-curtain-2); }
  .actions { display: flex; flex-wrap: wrap; gap: 12px; margin-top: 30px; }
  .status { margin-top: 18px; font-size: 14px; color: var(--on-curtain-2); font-weight: 600; }
  .status span { font-weight: 500; }
  .status.disc { margin-top: 6px; font-size: 12px; font-weight: 500; max-width: 46ch; opacity: .9; }

  .mirror { position: absolute; z-index: 3; left: 47vw; bottom: 12svh; width: min(41vw, 680px); height: min(74svh, 660px); transition: opacity .8s var(--ease), transform 1.1s var(--ease); }
  .frame { position: absolute; inset: 0; border-radius: 22px 22px 6px 6px; padding: 12px; background: linear-gradient(135deg, #e7ebf6, #aab3c8 45%, #dde2ee 60%, #8d97ad); box-shadow: 0 30px 60px rgb(10 15 60 / .28), 0 2px 0 rgb(255 255 255 / .6) inset; }
  .glass { container-type: inline-size; position: relative; width: 100%; height: 100%; border-radius: 12px 12px 2px 2px; background: var(--paper); overflow: hidden; color: var(--ink); }
  .glass::after { content: ''; position: absolute; inset: 0; pointer-events: none; background: linear-gradient(115deg, transparent 38%, rgb(255 255 255 / .22) 46%, transparent 54%); }

  .pf { padding: 5cqw 5.5cqw; height: 100%; display: flex; flex-direction: column; }
  .pf-head { display: flex; align-items: center; gap: 3.2cqw; }
  .pf-av { width: 12cqw; height: 12cqw; border-radius: 50%; overflow: hidden; background: var(--wall-2); flex: none; display: block; }
  .pf-av { object-fit: cover; }
  .pf-head b { display: block; font-family: var(--f-display); font-size: 5.2cqw; letter-spacing: -.03em; }
  .pf-head small { color: var(--ink-3); font-size: 2.7cqw; }
  .pf-tabs { position: relative; display: flex; margin-top: 4cqw; border-bottom: 1px solid var(--line); }
  .pf-tabs span { flex: 1; text-align: center; padding: 2.6cqw 0; font-weight: 700; font-size: 3cqw; color: var(--ink-3); display: inline-flex; gap: 1.2cqw; align-items: center; justify-content: center; }
  .pf-tabs .t-about { color: var(--ink); }
  .t-out { opacity: 0; transform: translateX(5cqw); transition: opacity .5s, transform .9s var(--spring), color .3s; }
  .t-line { position: absolute; left: 0; bottom: -1px; height: 2px; width: 33.3%; background: var(--ink); transition: transform .6s var(--ease); }
  .pf-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 3cqw; margin-top: 4cqw; flex: 1; align-content: start; }
  .tile { opacity: 0; transform: translateY(12px) scale(.94); transition: opacity .45s, transform .7s var(--spring), box-shadow .3s, background .3s; transition-delay: calc(var(--i) * 80ms); border-radius: 2.4cqw; background: var(--wall); text-align: center; padding: 1.6cqw 1cqw 2cqw; }
  .fig { overflow: hidden; border-radius: 1.6cqw; }
  .fig img { width: 100%; height: auto; max-height: 21cqw; object-fit: contain; display: block; transform: scale(1.35); }
  .fig { display: block; }
  .tile b { display: block; font-size: 2.4cqw; font-weight: 700; margin-top: .6cqw; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
  .pf-tag { position: absolute; right: 5.5cqw; bottom: 4cqw; font-size: 2.9cqw; opacity: 0; transform: translateY(14px) rotate(-3deg) scale(.9); transition: opacity .4s, transform .8s var(--spring); }
  .cursor { position: absolute; left: 0; top: 0; z-index: 9; opacity: 0; transform: translate(70cqw, 80cqh); transition: transform 1s var(--ease), opacity .3s; filter: drop-shadow(0 2px 3px rgb(0 0 0 / .35)); pointer-events: none; }
  .ripple { position: absolute; z-index: 8; width: 10cqw; height: 10cqw; margin: -5cqw 0 0 -5cqw; border-radius: 50%; border: 2px solid var(--curtain); opacity: 0; pointer-events: none; }

  /* initial (closed) state, then cumulative stages added by hero.ts */
  .mirror { opacity: 0; transform: translateY(14px) scale(.985); }
  .s1 .mirror { opacity: 1; transform: none; }
  .s1 .cl { transform: scaleX(.8); }
  .s1 .cr { transform: scaleX(.22); }
  .s2 .pf-head, .s2 .pf-tabs { opacity: 1; }
  .pf-head, .pf-tabs { opacity: 0; transition: opacity .6s .2s; }
  .s3 .t-out { opacity: 1; transform: none; }
  .s4 .cursor { opacity: 1; transform: translate(var(--tx, 70cqw), var(--ty, 20cqh)); }
  .s5 .t-line { transform: translateX(200%); }
  .s5 .t-out { color: var(--ink); }
  .s5 .t-about { color: var(--ink-3); }
  .s5 .tile { opacity: 1; transform: none; }
  .s5 .ripple { animation: ripple .7s var(--ease); left: var(--rx); top: var(--ry); }
  .s6 .tile.pick { background: #e8edff; box-shadow: inset 0 0 0 2px var(--curtain); transform: translateY(-5px) scale(1.04); transition-delay: 0s; }
  .s6 .pf-tag { opacity: 1; transform: none; }
  @keyframes ripple { 0% { opacity: .9; transform: scale(.3); } 100% { opacity: 0; transform: scale(2); } }

  /* no JS or reduced motion: show the finished scene */
  :global(html:not(.js)) .stall .mirror, :global(html:not(.js)) .stall .pf-head, :global(html:not(.js)) .stall .pf-tabs, :global(html:not(.js)) .stall .t-out, :global(html:not(.js)) .stall .tile, :global(html:not(.js)) .stall .pf-tag { opacity: 1; transform: none; }
  :global(html:not(.js)) .stall .cl { transform: scaleX(.8); }
  :global(html:not(.js)) .stall .cr { transform: scaleX(.22); }

  @media (max-width: 860px) {
    .stall { min-height: auto; padding-bottom: 0; }
    .curtain { width: 100%; bottom: auto; height: 100%; }
    .cr { display: none; }
    .cl { transform-origin: 0 0; }
    .s1 .cl { transform: scaleY(.66); }
    .copy { position: relative; left: auto; top: auto; bottom: auto; display: block; width: auto; padding: calc(var(--nav-h) + 52px) var(--gutter) 64px; }
    .mirror { position: relative; left: auto; bottom: auto; width: min(92vw, 520px); height: auto; aspect-ratio: 1 / 1.08; margin: 0 auto 0; z-index: 5; }
    .floor { height: 90px; }
    .stall { padding-bottom: 20px; }
    .curtain { height: 100%; }
  }
</style>

<script>
  import { runHero } from '../scripts/hero';
  runHero();
</script>
