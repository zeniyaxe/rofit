---
import GithubMark from './GithubMark.astro';
import { LINKS } from '../config';
---
<section class="close field" id="install" aria-labelledby="close-h">
  <div class="wrap">
    <h2 id="close-h">Open any profile.</h2>
    <ol class="steps">
      <li><b>Install RoFit</b><span>Load it into Chrome, Edge or Brave. It takes about a minute and needs no account.</span></li>
      <li><b>Visit a Roblox profile</b><span>A <em>Saved Outfits</em> row appears under Currently Wearing. Nothing is fetched until you click it.</span></li>
      <li><b>Get the look</b><span>Every piece, every price Roblox knows, and a library that stays on your own computer.</span></li>
    </ol>
    <div class="acts">
      <a class="btn" href="/download">Install RoFit<svg class="go" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6" /></svg></a>
      <a class="btn line" href={LINKS.github} rel="noopener"><GithubMark size={18} />Read the source</a>
    </div>
  </div>
</section>

<style>
  .close { margin-top: var(--section); padding-block: clamp(80px, 10vw, 150px) clamp(64px, 8vw, 110px); }
  h2 { font-size: clamp(3.6rem, 12vw, 11rem); font-stretch: var(--narrow); font-weight: 900; text-transform: uppercase; line-height: .84; letter-spacing: -.03em; }
  .steps { list-style: none; counter-reset: s; display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: var(--s6); margin-top: var(--s8); }
  .steps li { counter-increment: s; display: grid; gap: 6px; align-content: start; padding-top: var(--s4); border-top: 1.5px solid var(--spot-ink); }
  .steps li::before { content: counter(s); font-family: var(--f-display); font-stretch: var(--wide); font-weight: 800; font-size: var(--t-h5); }
  .steps b { font-size: var(--t-h5); font-weight: 760; }
  .steps em { font-style: normal; font-weight: 700; }
  .acts { display: flex; flex-wrap: wrap; gap: var(--s3); margin-top: var(--s8); }
  @media (max-width: 860px) { .steps { grid-template-columns: minmax(0, 1fr); } }
</style>
