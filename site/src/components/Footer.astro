---
import { LINKS } from '../config';
---
<footer class="foot on-curtain">
  <div class="wrap">
    <div>
      <p class="big">RoFit</p>
      <p class="lead">Saved outfits, piece by piece. Free, source on GitHub, and nothing leaves your browser.</p>
    </div>
    <div>
      <h2>Product</h2>
      <ul>
        <li><a href="/install">Install</a></li>
        <li><a href="/#demo">Try it</a></li>
        <li><a href="/guides">Guides</a></li>
        <li><a href="/roadmap">Roadmap</a></li>
        <li><a href="/changelog">Changelog</a></li>
      </ul>
    </div>
    <div>
      <h2>Trust</h2>
      <ul>
        <li><a href="/privacy">Privacy</a></li>
        <li><a href="/security">Security</a></li>
        <li><a href="/terms">Terms</a></li>
        <li><a href={LINKS.github} rel="noopener">Source on GitHub</a></li>
      </ul>
    </div>
    <div>
      <h2>Help</h2>
      <ul>
        <li><a href="/support">Support</a></li>
        {LINKS.supportEmail && <li><a href={`mailto:${LINKS.supportEmail}`}>{LINKS.supportEmail}</a></li>}
        {LINKS.donate && <li><a class="don" href={LINKS.donate} rel="noopener">♥ Donate</a></li>}
        <li><a href={LINKS.issues} rel="noopener">Report a bug</a></li>
        {LINKS.discord && <li><a href={LINKS.discord} rel="noopener">Discord</a></li>}
      </ul>
    </div>
    <div class="fine">
      <p>RoFit is an independent project. It is not affiliated with, endorsed by, or sponsored by Roblox Corporation. Roblox is a trademark of Roblox Corporation. Avatar pictures on this site are real public Roblox profiles, labelled and dated; the players, item creators and Roblox are not affiliated with or endorsing RoFit.</p>
      <div class="display">
        <button class="display-btn" id="display-btn" aria-expanded="false" aria-controls="display-pop">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="4" /><path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4" /></svg>
          Display
        </button>
        <div class="display-pop" id="display-pop" role="group" aria-label="Display preferences" hidden>
          <fieldset>
            <legend>Theme</legend>
            <div class="seg">
              <label><input type="radio" name="theme" value="system" />System</label>
              <label><input type="radio" name="theme" value="light" />Light</label>
              <label><input type="radio" name="theme" value="dark" />Dark</label>
            </div>
          </fieldset>
          <fieldset>
            <legend>Motion</legend>
            <div class="seg">
              <label><input type="radio" name="motion" value="system" />System</label>
              <label><input type="radio" name="motion" value="full" />Full</label>
              <label><input type="radio" name="motion" value="reduced" />Calm</label>
              <label><input type="radio" name="motion" value="off" />Off</label>
            </div>
          </fieldset>
          <p>Saved on this device only. “System” follows your operating system.</p>
        </div>
      </div>
    </div>
  </div>
</footer>

<script>
  import { initDisplay } from '../scripts/display';
  initDisplay();
</script>
