---
import { LINKS } from '../config';
---
<footer class="foot">
  <div class="wrap">
    <div class="cols">
      <div>
        <a class="wordmark" href="/" style="font-size:30px">RoFit<span class="dot" aria-hidden="true"></span></a>
        <p class="lead">Saved Roblox outfits, piece by piece. A free browser extension that reads only what Roblox already shows you.</p>
      </div>
      <div>
        <h2>Product</h2>
        <ul>
          <li><a href="/download">Install</a></li>
          <li><a href="/#try">Try it live</a></li>
          <li><a href="/features">Features</a></li>
          <li><a href="/roadmap">Roadmap</a></li>
          <li><a href="/changelog">Changelog</a></li>
        </ul>
      </div>
      <div>
        <h2>Trust</h2>
        <ul>
          <li><a href="/privacy">Privacy</a></li>
          <li><a href="/security">Security</a></li>
          <li><a href="/terms">Terms</a></li>
          <li><a href={LINKS.github} rel="noopener">Source on GitHub</a></li>
        </ul>
      </div>
      <div>
        <h2>Help</h2>
        <ul>
          <li><a href="/docs">Docs</a></li>
          <li><a href="/guides">Guides</a></li>
          <li><a href="/support">Support</a></li>
          {LINKS.supportEmail && <li><a href={`mailto:${LINKS.supportEmail}`}>{LINKS.supportEmail}</a></li>}
          <li><a href={LINKS.issues} rel="noopener">Report a bug</a></li>
          {LINKS.donate && <li><a href={LINKS.donate} rel="noopener">Donate</a></li>}
          {LINKS.discord && <li><a href={LINKS.discord} rel="noopener">Discord</a></li>}
        </ul>
      </div>
    </div>
    <div class="fine">
      <p>RoFit is an independent project. It is not affiliated with, endorsed by, or sponsored by Roblox Corporation. Roblox is a trademark of Roblox Corporation. Outfit pictures on this site come from real public Roblox profiles, labelled and dated; those players, the item creators and Roblox do not endorse RoFit.</p>
      <div class="display">
        <button class="display-btn" id="display-btn" type="button" aria-expanded="false" aria-controls="display-pop">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><circle cx="12" cy="12" r="8" /><path d="M12 4v16" /><path d="M12 4a8 8 0 0 1 0 16" fill="currentColor" stroke="none" /></svg>
          Display
        </button>
        <div class="display-pop" id="display-pop" role="group" aria-label="Display preferences" hidden>
          <fieldset>
            <legend>Theme</legend>
            <div class="seg">
              <label><input type="radio" name="theme" value="system" />System</label>
              <label><input type="radio" name="theme" value="light" />Light</label>
              <label><input type="radio" name="theme" value="dark" />Dark</label>
            </div>
          </fieldset>
          <fieldset>
            <legend>Motion</legend>
            <div class="seg">
              <label><input type="radio" name="motion" value="system" />System</label>
              <label><input type="radio" name="motion" value="full" />Full</label>
              <label><input type="radio" name="motion" value="reduced" />Calm</label>
              <label><input type="radio" name="motion" value="off" />Off</label>
            </div>
          </fieldset>
          <p>Saved on this device only. System follows your operating system.</p>
        </div>
      </div>
    </div>
  </div>
  <p class="mast" aria-hidden="true">RoFit</p>
</footer>

<script>
  import { initDisplay } from '../scripts/display';
  initDisplay();
</script>
