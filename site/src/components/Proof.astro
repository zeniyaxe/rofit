---
import { facts, PERMISSION_WORDS, HOST_WORDS, networkCallSites } from '../lib/privacy';
import { LINKS } from '../config';
const hostName = (h: string) => h.replace('https://', '').replace('/*', '');
---
<section class="proof" id="proof" aria-labelledby="proof-h">
  <div class="top">
    <h2 id="proof-h">Don’t take our word for it.</h2>
    <p>This list is read from the extension’s own manifest every time this site is built. If the extension ever asks for more, this page changes or the build fails.</p>
  </div>

  <div class="ledger rv">
    <div class="sheet">
      <p class="cap">RoFit {facts.version} · manifest.json</p>
      <h3>Permissions it asks the browser for</h3>
      <ul class="perm">
        {facts.permissions.map((p) => (
          <li><code>{p}</code><span><b>{PERMISSION_WORDS[p].name}.</b> {PERMISSION_WORDS[p].why}</span></li>
        ))}
      </ul>
      <h3>Websites it can talk to</h3>
      <ul class="perm">
        {facts.hostPermissions.map((h) => (
          <li><code>{hostName(h)}</code><span>{HOST_WORDS[h]}</span></li>
        ))}
        <li class="none"><code>everything else</code><span>No other address. No analytics, no ads, no RoFit server.</span></li>
      </ul>
    </div>

    <div class="notes">
      <h3>What that adds up to</h3>
      <ul class="no">
        <li><b>It never reads your Roblox login.</b> It has no cookie permission. Requests go out through the Roblox tab you already have open, as you.</li>
        <li><b>It runs no remote code.</b> Everything it runs ships inside the extension; the content security policy is <code>script-src 'self'</code>.</li>
        <li><b>It only reads from Roblox.</b> It cannot change your avatar or any account setting.</li>
        <li><b>Network calls live in {networkCallSites.length} source files</b>, and the build checks that number. Small enough to read in an afternoon.</li>
      </ul>
      <p class="how">Verify it yourself: open <code>chrome://extensions</code>, choose RoFit, and look at <i>Permissions</i>. Or <a href={LINKS.github} rel="noopener">read the source</a>.</p>
      <a class="more" href="/privacy">Read the full privacy policy</a>
    </div>
  </div>
</section>

<style>
  .proof { width: min(100%, calc(var(--maxw) + var(--gutter) * 2)); margin: clamp(90px, 14vw, 180px) auto 0; padding: 0 var(--gutter); }
  .top { max-width: 64ch; }
  h2 { font-size: clamp(2rem, 4.2vw, 4rem); letter-spacing: -.035em; }
  .top p { margin-top: 16px; color: var(--ink-2); }
  .ledger { display: grid; grid-template-columns: minmax(0, 1.4fr) minmax(0, 1fr); gap: clamp(28px, 5vw, 72px); margin-top: 44px; align-items: start; }
  .sheet { position: relative; padding: clamp(20px, 3vw, 36px); background: var(--paper); border-radius: 6px; box-shadow: 0 0 0 1px var(--line), 0 24px 60px rgb(15 20 60 / .12); }
  .sheet::after { content: ''; position: absolute; left: 0; right: 0; bottom: -9px; height: 10px; background: linear-gradient(135deg, var(--paper) 50%, transparent 50%) 0 0 / 14px 10px repeat-x, linear-gradient(225deg, var(--paper) 50%, transparent 50%) 0 0 / 14px 10px repeat-x; }
  .cap { font-family: ui-monospace, 'Cascadia Mono', Consolas, monospace; font-size: 13px; color: var(--ink-3); }
  h3 { font-family: var(--f-body); font-size: 15px; letter-spacing: 0; margin: 22px 0 6px; }
  .perm { list-style: none; margin: 0; padding: 0; }
  .perm li { display: grid; grid-template-columns: minmax(130px, 200px) 1fr; gap: 6px 18px; padding: 11px 0; border-top: 1px dashed var(--line); font-size: 15px; color: var(--ink-2); }
  .perm li:first-child { border-top: 0; }
  .perm b { color: var(--ink); }
  code { font-family: ui-monospace, 'Cascadia Mono', Consolas, monospace; font-size: .9em; }
  .perm code { font-weight: 600; color: var(--ink); overflow-wrap: anywhere; }
  .none code { color: var(--ok); }
  .notes h3 { margin-top: 0; font-size: 18px; }
  .no { list-style: none; padding: 0; margin: 14px 0 0; display: grid; gap: 16px; }
  .no li { padding-left: 22px; position: relative; color: var(--ink-2); }
  .no li::before { content: ''; position: absolute; left: 0; top: .5em; width: 9px; height: 9px; border-radius: 50%; background: var(--curtain); }
  .no b { color: var(--ink); }
  .how { margin-top: 22px; font-size: 15px; color: var(--ink-2); }
  .how a { color: var(--curtain); font-weight: 600; }
  :global(:root[data-theme='dark']) .how a { color: var(--curtain-hi); }
  .more { display: inline-block; margin-top: 18px; font-weight: 800; text-decoration: none; border-bottom: 2px solid var(--curtain); padding-bottom: 2px; }
  @media (max-width: 900px) { .ledger { grid-template-columns: 1fr; } .perm li { grid-template-columns: 1fr; } }
</style>
