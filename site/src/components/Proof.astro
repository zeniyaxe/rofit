---
import { facts, PERMISSION_WORDS, HOST_WORDS, networkCallSites } from '../lib/privacy';
import { LINKS } from '../config';
const hostName = (h: string) => h.replace('https://', '').replace('/*', '');
---
<section class="proof section" id="proof" aria-labelledby="proof-h">
  <div class="wrap">
    <div class="ledger">
      <div class="head">
        <h2 id="proof-h" class="rv">Don’t take our word for it.</h2>
        <p class="rv" style="--i:1">This list is read from the extension’s own manifest every time this site is built. If the extension ever asks for more, this page changes or the build fails.</p>
      </div>
      <div class="sheet rv">
        <p class="cap"><span>RoFit {facts.version}</span><span>manifest.json</span></p>
        <h3>Permissions it asks the browser for</h3>
        <ul class="perm">
          {facts.permissions.map((p) => (
            <li><code>{p}</code><span><b>{PERMISSION_WORDS[p].name}.</b> {PERMISSION_WORDS[p].why}</span></li>
          ))}
        </ul>
        <h3>Websites it can talk to</h3>
        <ul class="perm">
          {facts.hostPermissions.map((h) => (
            <li><code>{hostName(h)}</code><span>{HOST_WORDS[h]}</span></li>
          ))}
          <li class="none"><code>everything else</code><span>No other address. No analytics, no ads, no RoFit server.</span></li>
        </ul>
      </div>

      <div class="notes">
        <h3>What that adds up to</h3>
        <ul class="no-list">
          <li><b>It never reads your Roblox login.</b> It has no cookie permission. Requests go out through the Roblox tab you already have open, as you.</li>
          <li><b>It runs no remote code.</b> Everything it runs ships inside the extension; the content security policy is <code>script-src 'self'</code>.</li>
          <li><b>It only reads from Roblox.</b> It cannot change your avatar or any account setting.</li>
          <li><b>Network calls live in {networkCallSites.length} source files</b>, and the build checks that number. Small enough to read in an afternoon.</li>
        </ul>
        <p class="how">Check it yourself: open <code>chrome://extensions</code>, choose RoFit, and look at <i>Permissions</i>. Or <a class="link" href={LINKS.github} rel="noopener">read the source</a>.</p>
        <a class="btn line sm" href="/privacy">Read the privacy policy</a>
      </div>
    </div>
  </div>
</section>

<style>
  /* the heading holds its column while the manifest scrolls past it */
  .ledger { display: grid; grid-template-columns: minmax(0, .8fr) minmax(0, 1.25fr); grid-template-areas: 'head sheet' 'notes sheet'; gap: var(--s7) var(--s8); align-items: start; }
  .head { grid-area: head; position: sticky; top: calc(var(--nav-h) + 32px); }
  .head h2 { font-size: clamp(3rem, 6.6vw, 6.4rem); font-stretch: var(--narrow); font-weight: 900; text-transform: uppercase; line-height: .86; }
  .head p { margin-top: var(--s5); color: var(--ink-2); max-width: 40ch; }
  .sheet { grid-area: sheet; }
  .notes { grid-area: notes; }
  .sheet { padding: clamp(20px, 3vw, 36px); background: var(--stock); border-radius: var(--r); box-shadow: 0 0 0 1px var(--rule); }
  .cap { display: flex; justify-content: space-between; gap: var(--s4); padding-bottom: var(--s3); border-bottom: 1.5px solid var(--ink); font-family: var(--f-display); font-stretch: var(--wide); font-weight: 650; font-size: var(--t-tiny); }
  h3 { font-family: var(--f-body); font-stretch: normal; font-size: var(--t-ui-l); font-weight: 750; letter-spacing: 0; margin: var(--s5) 0 var(--s2); }
  .perm { list-style: none; }
  .perm li { display: grid; grid-template-columns: minmax(130px, 210px) minmax(0, 1fr); gap: 4px var(--s5); padding: 11px 0; border-top: 1px dashed var(--rule); font-size: var(--t-ui); color: var(--ink-2); }
  .perm li:first-child { border-top: 0; }
  .perm b { color: var(--ink); }
  .perm code { font-weight: 600; color: var(--ink); overflow-wrap: anywhere; }
  .none code { color: var(--ink); text-decoration: underline 2px var(--spot); text-underline-offset: .25em; }
  .notes h3 { margin-top: 0; font-family: var(--f-display); font-stretch: var(--cond); font-size: var(--t-h4); font-weight: 820; }
  .no-list { list-style: none; display: grid; gap: var(--s4); margin-top: var(--s4); }
  .no-list li { padding-left: 22px; position: relative; color: var(--ink-2); }
  .no-list li::before { content: ''; position: absolute; left: 0; top: .55em; width: 9px; height: 9px; background: var(--spot); border-radius: 50%; }
  .no-list b { color: var(--ink); }
  .how { margin: var(--s5) 0; font-size: var(--t-ui); color: var(--ink-2); }
  code { font-size: .86em; }
  @media (max-width: 900px) { .ledger { grid-template-columns: minmax(0, 1fr); grid-template-areas: 'head' 'sheet' 'notes'; } .head { position: static; } .perm li { grid-template-columns: minmax(0, 1fr); } }
</style>
