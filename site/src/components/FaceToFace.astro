---
import { pair, item, priceOf, kindOf, money, visible, ownerOfOutfit, cardStats } from '../lib/real';
const [a, b] = pair;
const owner = ownerOfOutfit(a.id);
const ids = (o: typeof a) => new Set(o.assets.map((x) => x.id));
const A = ids(a), B = ids(b);
const row = (x: { id: number; name: string; typeName: string }) => ({ ...x, rec: item(x.id) });
const vis = (x: { typeName: string }) => visible({ typeName: x.typeName } as any);
const onlyA = a.assets.filter((x) => !B.has(x.id) && vis(x)).map(row);
const onlyB = b.assets.filter((x) => !A.has(x.id) && vis(x)).map(row);
const both = a.assets.filter((x) => B.has(x.id) && vis(x)).map(row);
const total = new Set([...a.assets, ...b.assets].filter(vis).map((x) => x.id)).size;
const onSale = (rows: ReturnType<typeof row>[]) => rows.reduce((n, r) => n + (r.rec?.forSale && r.rec.price ? r.rec.price : 0), 0);
const cols = [
  { key: 'a', title: `Only in ${a.name}`, rows: onlyA },
  { key: 'both', title: 'In both', rows: both },
  { key: 'b', title: `Only in ${b.name}`, rows: onlyB },
];
const cards = [{ o: a, side: 'a', mine: onlyA.length }, { o: b, side: 'b', mine: onlyB.length }];
---
<section class="f2f field" id="compare" aria-labelledby="f2f-h">
  <div class="wrap">
    <h2 id="f2f-h" class="rv">Face to face.</h2>
    <div class="intro">
      <p class="rv" style="--i:1">Pick two looks. RoFit sets them side by side or wipes from one to the other, then sorts every piece into what they share and what only one of them has, with what the difference costs.</p>
      <div class="modes rv" style="--i:2" role="group" aria-label="How to show the two outfits">
        <button type="button" aria-pressed="true" data-mode="side">Side by side</button>
        <button type="button" aria-pressed="false" data-mode="wipe">Wipe</button>
      </div>
    </div>

    <div class="stage" data-mode="side" style="--at:50%">
      <div class="duo" aria-hidden="false">
        {cards.map(({ o, side, mine }) => { const s = cardStats(o); return (
          <article class={'cc ' + side}>
            <div class="art"><img src={o.thumb} alt={o.name} width="420" height="420" loading="lazy" decoding="async" /><span class="no">{o.id}</span></div>
            <div class="body">
              <h3>{o.name}</h3>
              <p class="stats"><span>{s.pieces} pieces</span><span>{mine} only here</span>{s.forSale > 0 ? <span class="price known">{money(s.total)}</span> : <span class="price off">Off sale</span>}</p>
            </div>
          </article>
        ); })}
        <p class="meet" aria-label={`${both.length} of ${total} pieces shared`}><strong class="num">{both.length}</strong><span>of {total}{' '}<br />shared</span></p>
      </div>
      <figure class="wipe" aria-hidden="true">
        <div class="pane b"><img src={b.thumb} alt="" width="420" height="420" loading="lazy" decoding="async" /></div>
        <div class="pane a"><img src={a.thumb} alt="" width="420" height="420" loading="lazy" decoding="async" /></div>
        <span class="lab la"><span class="no">{a.id}</span><b>{a.name}</b></span>
        <span class="lab lb"><span class="no">{b.id}</span><b>{b.name}</b></span>
        <span class="rule" aria-hidden="true"><i></i></span>
        <input type="range" min="0" max="100" value="50" step="1" tabindex="-1" aria-label={`Wipe between ${a.name} and ${b.name}`} aria-valuetext={`50% ${a.name}`} />
      </figure>
    </div>
    <p class="who">Two outfits {owner?.displayName ?? 'one player'} saved, as RoFit lays them out.</p>

    <div class="ledger">
      {cols.map((c) => (
        <section class={'col ' + c.key} aria-label={c.title}>
          <h3><span>{c.title}</span><span class="num">{c.rows.length}</span></h3>
          <ul>
            {c.rows.map((r) => { const p = priceOf(r.rec); return (
              <li>
                {r.rec?.thumb ? <img src={r.rec.thumb} alt="" width="40" height="40" loading="lazy" /> : <span class="ph" aria-hidden="true"></span>}
                <span class="t"><b>{r.rec?.name ?? r.name}</b><small>{kindOf(r.typeName)}</small></span>
                <span class="tags">{r.rec?.limited && <span class="ltd">Ltd</span>}<span class={'price ' + p.tone} aria-label={p.aria}>{p.text}</span></span>
              </li>
            ); })}
          </ul>
          {c.key !== 'both' && <p class="sum">On sale new: <strong class="num">{onSale(c.rows) ? money(onSale(c.rows)) : 'nothing'}</strong></p>}
        </section>
      ))}
    </div>
  </div>
</section>

<style>
  .f2f { margin-top: var(--section); padding-block: clamp(72px, 9vw, 130px); }
  h2 { font-size: clamp(3.6rem, 11vw, 10rem); font-stretch: var(--narrow); font-weight: 900; text-transform: uppercase; line-height: .84; letter-spacing: -.02em; }
  .intro { display: grid; grid-template-columns: minmax(0, 1fr) auto; gap: var(--s5) var(--s7); align-items: end; margin-top: var(--s5); padding-top: var(--s4); border-top: 1.5px solid var(--spot-ink); }
  .intro p { max-width: 54ch; }
  .modes { display: inline-flex; padding: 3px; gap: 3px; box-shadow: inset 0 0 0 1.5px var(--spot-ink); border-radius: var(--r-sm); }
  .modes button { min-height: 42px; padding: 0 16px; font-weight: 700; font-size: var(--t-small); border-radius: 1px; transition: background var(--d-fast), color var(--d-fast); }
  .modes button[aria-pressed='true'] { background: var(--spot-ink); color: var(--spot); }

  .stage { position: relative; display: grid; margin-top: var(--s7); }
  .duo, .wipe { grid-area: 1 / 1; transition: opacity var(--d) var(--ease), transform var(--d-slow) var(--land), visibility 0s linear var(--d); }
  .stage[data-mode='side'] .wipe, .stage[data-mode='wipe'] .duo { opacity: 0; visibility: hidden; pointer-events: none; }
  .stage[data-mode='wipe'] .duo { transform: scale(.96); }
  .stage[data-mode='side'] .wipe { transform: scale(1.03); }
  .stage[data-mode='side'] .duo, .stage[data-mode='wipe'] .wipe { transition-delay: 0s; visibility: visible; }

  /* two printed cards turned slightly toward each other */
  .duo { display: grid; grid-template-columns: minmax(0, 1fr) auto minmax(0, 1fr); gap: var(--s6); align-items: center; max-width: 1040px; margin-inline: auto; width: 100%; }
  .cc { background: #fff; color: #0c0c0d; border-radius: 3px; padding: 6px; box-shadow: inset 0 0 0 5px #fff, inset 0 0 0 6px rgb(12 12 13 / .16), 0 34px 60px -34px rgb(70 0 25 / .75); transition: transform var(--d-slow) var(--land); }
  .cc.a { grid-column: 1; grid-row: 1; transform: rotate(-2deg) translateY(6px); }
  .meet { grid-column: 2; grid-row: 1; }
  .cc.b { grid-column: 3; grid-row: 1; transform: rotate(2deg) translateY(6px); }
  :root[data-motion='full'] .cc:hover { transform: rotate(0) translateY(calc(var(--nudge) * -1)); }
  .cc .art { position: relative; aspect-ratio: 1; background: #efefeb; border-radius: 1px; }
  .cc .art img { width: 100%; height: 100%; object-fit: contain; }
  .cc .no { position: absolute; left: 8px; top: 8px; color: #45454b; }
  .cc .body { padding: 12px 8px 8px; display: grid; gap: 6px; }
  .cc h3 { font-size: var(--t-h4); font-stretch: var(--cond); }
  .cc .stats { display: flex; flex-wrap: wrap; align-items: center; gap: 4px 12px; font-family: var(--f-display); font-stretch: 112%; font-weight: 560; font-size: .76rem; color: #45454b; }
  .cc .stats .price { font-family: var(--f-display); color: #0c0c0d; }
  .meet { display: grid; justify-items: center; text-align: center; gap: 4px; font-weight: 700; font-size: var(--t-small); line-height: 1.2; }
  .meet strong { font-family: var(--f-display); font-stretch: var(--wide); font-weight: 860; font-size: clamp(3.4rem, 7vw, 6rem); line-height: .8; }

  .wipe { position: relative; margin: 0 auto; width: min(100%, 760px); aspect-ratio: 1.3; background: #fff; border-radius: 3px; overflow: hidden; box-shadow: 0 34px 60px -36px rgb(70 0 25 / .75); touch-action: pan-y; color: #0c0c0d; }
  .pane { position: absolute; inset: 0; display: grid; place-items: center; background: #fff; }
  .pane img { width: 86%; height: 86%; object-fit: contain; }
  .pane.a { clip-path: inset(0 calc(100% - var(--at)) 0 0); }
  .lab { position: absolute; top: 14px; display: grid; gap: 2px; max-width: 44%; font-size: var(--t-small); line-height: 1.2; z-index: 2; pointer-events: none; }
  .lab b { font-weight: 760; }
  .la { left: 16px; }
  .lb { right: 16px; text-align: right; justify-items: end; }
  .rule { position: absolute; top: 0; bottom: 0; left: var(--at); width: 0; border-left: 1.5px solid #0c0c0d; z-index: 2; pointer-events: none; }
  .rule i { position: absolute; top: 50%; left: 0; width: 46px; height: 46px; margin: -23px 0 0 -23px; border-radius: 50%; background: #0c0c0d; transition: transform var(--d) var(--land); }
  .rule i::before, .rule i::after { content: ''; position: absolute; top: 50%; width: 8px; height: 8px; margin-top: -4px; border: solid var(--spot); border-width: 0 0 2px 2px; }
  .rule i::before { left: 11px; transform: rotate(45deg); }
  .rule i::after { right: 11px; transform: rotate(-135deg); }
  .wipe input { position: absolute; inset: 0; width: 100%; height: 100%; margin: 0; opacity: 0; cursor: ew-resize; z-index: 3; }
  .wipe:has(input:focus-visible) { outline: 2px solid var(--spot-ink); outline-offset: 4px; }
  .wipe:has(input:active) .rule i { transform: scale(1.12); }
  .who { margin-top: var(--s6); font-size: var(--t-small); text-align: center; }

  .ledger { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: var(--s6); margin-top: clamp(48px, 7vw, 96px); }
  .col h3 { display: flex; justify-content: space-between; gap: 10px; align-items: baseline; padding-bottom: 10px; border-bottom: 1.5px solid var(--spot-ink); font-size: var(--t-h5); }
  .col h3 span:first-child { overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
  .col h3 .num { font-stretch: var(--wide); font-weight: 650; font-size: var(--t-small); }
  .col ul { list-style: none; }
  .col li { display: grid; grid-template-columns: 40px minmax(0, 1fr) auto; gap: 12px; align-items: center; padding: 10px 0; border-bottom: 1px solid var(--rule); }
  .col li img, .col .ph { width: 40px; height: 40px; border-radius: var(--r-sm); background: rgb(255 255 255 / .55); object-fit: cover; }
  .col .ph { outline: 1px dashed var(--spot-rule); outline-offset: -1px; background: none; }
  .t { display: grid; min-width: 0; line-height: 1.25; }
  .t b { font-weight: 700; font-size: var(--t-ui); overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
  .t small { font-size: .78rem; color: var(--ink-2); }
  .tags { display: inline-flex; gap: 6px; align-items: center; }
  .sum { margin-top: var(--s3); font-size: var(--t-small); }
  .sum strong { font-family: var(--f-display); font-stretch: var(--wide); font-weight: 760; }
  @media (max-width: 960px) { .ledger { grid-template-columns: minmax(0, 1fr); } .intro { grid-template-columns: minmax(0, 1fr); } }
  @media (max-width: 640px) {
    .duo { grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); gap: var(--s3); }
    .cc.b { grid-column: 2; }
    .meet { grid-column: 1 / -1; grid-row: 2; grid-auto-flow: column; justify-content: center; align-items: baseline; gap: 10px; margin-top: var(--s2); }
    .meet br { display: none; }
    .cc.a { transform: rotate(-1.5deg); } .cc.b { transform: rotate(1.5deg); }
    .cc h3 { font-size: var(--t-h5); }
    .cc .stats span:nth-child(2) { display: none; }
    .wipe { aspect-ratio: .95; }
  }
</style>

<script>
  document.querySelectorAll<HTMLElement>('#compare .stage').forEach((stage) => {
    const wipe = stage.querySelector<HTMLElement>('.wipe')!;
    const input = wipe.querySelector('input')!;
    const name = input.getAttribute('aria-label')!.replace(/^Wipe between /, '').split(' and ')[0];
    const set = () => { stage.style.setProperty('--at', input.value + '%'); input.setAttribute('aria-valuetext', `${input.value}% ${name}`); };
    input.addEventListener('input', set);
    const buttons = [...document.querySelectorAll<HTMLButtonElement>('#compare .modes button')];
    let touched = false, swept = false;
    input.addEventListener('pointerdown', () => { touched = true; });
    input.addEventListener('keydown', () => { touched = true; });
    // One short sweep the first time the wipe is shown, Full motion only; any touch takes over at once.
    const sweep = () => {
      if (swept || document.documentElement.dataset.motion !== 'full') return;
      swept = true;
      const t0 = performance.now();
      const step = (t: number) => {
        if (touched || stage.dataset.mode !== 'wipe') return;
        const p = Math.min(1, (t - t0) / 1800);
        input.value = String(Math.round(50 + Math.sin(p * Math.PI * 2) * 24 * (1 - p)));
        set();
        if (p < 1) requestAnimationFrame(step);
      };
      requestAnimationFrame(step);
    };
    buttons.forEach((b) => b.addEventListener('click', () => {
      const mode = b.dataset.mode!;
      stage.dataset.mode = mode;
      buttons.forEach((x) => x.setAttribute('aria-pressed', String(x === b)));
      const isWipe = mode === 'wipe';
      wipe.setAttribute('aria-hidden', String(!isWipe));
      stage.querySelector('.duo')!.setAttribute('aria-hidden', String(isWipe));
      input.tabIndex = isWipe ? 0 : -1;
      if (isWipe) sweep();
    }));
  });
</script>
