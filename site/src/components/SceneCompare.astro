---
import { star, pair, item, money as rb } from '../lib/real';
import { examplePrice } from '../lib/example-price';

const [A, B] = pair;
const ids = [...new Set([...A.assets.map((a) => a.id), ...B.assets.map((a) => a.id)])];
const nameOf = (id: number) => A.assets.concat(B.assets).find((a) => a.id === id)!;
const rows = ids
  .map((id) => ({ id, ref: nameOf(id), it: item(id), inA: A.assets.some((a) => a.id === id), inB: B.assets.some((a) => a.id === id) }))
  .map((r, i) => ({ ...r, group: r.inA && r.inB ? 'both' : r.inA ? 'a' : 'b', order: i }));
const price = (id: number, it: ReturnType<typeof item>) =>
  it?.resolved && it.forSale && it.price != null ? (it.price === 0 ? 'Free' : rb(it.price)) : examplePrice(id);
---
<section class="compare" id="compare" aria-labelledby="cmp-h">
  <div class="wrap grid">
    <div class="cmp-copy rv">
      <h2 id="cmp-h">Spot the difference.</h2>
      <p>Drag to compare the looks, or see which pieces changed.</p>
      <div class="mode" role="radiogroup" aria-label="Compare view">
        <button role="radio" aria-checked="true" data-mode="slider" class="on">Slider</button>
        <button role="radio" aria-checked="false" data-mode="diff">Difference</button>
      </div>
    </div>

    <div class="rig rv" style="--i:1">
      <div class="mirror2">
        <div class="glass2" id="cmp-glass" style="--split:50%">
          <div class="side a" aria-label={A.name}><img class="fig2" src={A.thumb} alt={`${A.name}, saved by ${star.displayName}`} width="420" height="420" /></div>
          <div class="side b" aria-label={B.name}><img class="fig2" src={B.thumb} alt={`${B.name}, saved by ${star.displayName}`} width="420" height="420" /></div>
          <div class="labels"><b>{A.name}</b><b>{B.name}</b></div>
          <i class="bar" aria-hidden="true"><span class="knob"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M8 7l-5 5 5 5M16 7l5 5-5 5" /></svg></span></i>
          <label class="sr" for="cmp-range">Reveal slider between {A.name} and {B.name}</label>
          <input id="cmp-range" type="range" min="0" max="100" step="0.5" value="50" />
        </div>
      </div>

      <ul class="rows" id="cmp-rows" aria-label="Pieces in either outfit">
        {rows.map((r) => (
          <li class={'row ' + r.group} data-id={r.id} data-group={r.group} style={`--o:${r.order}`}>
            <span class="th">{r.it?.thumb && <img src={r.it.thumb} alt="" width="44" height="44" loading="lazy" />}</span>
            <span class="nm"><b>{r.it?.name ?? r.ref.name}</b><small>{r.it?.creator?.name ?? r.ref.typeName} · {price(r.id)}</small></span>
            <span class="pres" aria-label={r.group === 'both' ? 'in both' : r.group === 'a' ? `only in ${A.name}` : `only in ${B.name}`}>
              <i class={r.inA ? 'on' : ''} title={A.name}></i><i class={r.inB ? 'on' : ''} title={B.name}></i>
            </span>
            <em class="sign" aria-hidden="true">{r.group === 'both' ? '=' : r.group === 'a' ? '−' : '+'}</em>
          </li>
        ))}
        <li class="gh gh-a" aria-hidden="true">Only in {A.name}</li>
        <li class="gh gh-both" aria-hidden="true">In both</li>
        <li class="gh gh-b" aria-hidden="true">Only in {B.name}</li>
      </ul>
    </div>
  </div>
</section>

<style>
  .compare { padding: clamp(80px, 12vw, 160px) 0 0; }
  .grid { display: grid; grid-template-columns: minmax(0, 1fr); gap: clamp(24px, 4vw, 48px); justify-items: center; }
  h2 { font-size: clamp(2rem, 4.2vw, 4rem); letter-spacing: -.035em; }
  .cmp-copy { text-align: center; }
  .cmp-copy p { margin-top: 18px; color: var(--ink-2); max-width: 56ch; margin-inline: auto; }
  .mode { display: inline-grid; grid-auto-flow: column; gap: 4px; padding: 4px; border-radius: 12px; background: var(--wall-2); margin-top: 28px; position: relative; }
  .mode button { min-height: 44px; padding: 0 20px; border-radius: 9px; font-weight: 700; color: var(--ink-2); transition: background .2s, color .2s, box-shadow .2s, transform .3s var(--spring); }
  .mode button.on { background: var(--paper); color: var(--ink); box-shadow: 0 1px 3px rgb(0 0 0 / .18); }
  .mode button:active { transform: scale(.96); }

  .rig { display: grid; justify-items: center; gap: 18px; width: min(100%, 700px); min-width: 0; }
  .mirror2 { display: flex; width: 100%; min-width: 0; padding: clamp(5px, 1vw, 9px); border-radius: 20px; background: var(--wall-2); border: 1px solid var(--line); }
  .glass2 { position: relative; flex: 1; min-height: 0; height: clamp(280px, 66vw, 435px); border-radius: 12px; overflow: hidden; background: var(--paper); touch-action: pan-y; user-select: none; cursor: ew-resize; container-type: inline-size; }
  .side { position: absolute; inset: 0; display: grid; place-items: center; transition: opacity .3s; }
  .side.a { background: radial-gradient(ellipse at 50% 80%, color-mix(in srgb, #8398c8 28%, transparent), transparent 68%), var(--paper); }
  .side.b { clip-path: inset(0 0 0 var(--split)); background: radial-gradient(ellipse at 50% 80%, color-mix(in srgb, #b79b80 28%, transparent), transparent 68%), var(--paper); }
  /* Register the shared torso and legs to the seam, independent of each PNG’s transparent margins. */
  .side.a { --align-x: -1.2%; --align-y: 4%; }
  .side.b { --align-x: -5.3%; --align-y: 3%; }
  .fig2 { display: block; width: min(100cqw, 435px, 66vw); height: auto; aspect-ratio: 1; object-fit: contain; transform: translate(var(--align-x), var(--align-y)); transition: transform .55s var(--ease); }
  .row .th img { width: 100%; height: 100%; object-fit: contain; background: #eef0f5; }
  .labels { position: absolute; inset: 10px 10px auto; display: flex; justify-content: space-between; gap: 6px; pointer-events: none; }
  .labels b { max-width: 48%; font-size: clamp(.66rem, 2.2vw, .8rem); line-height: 1.2; padding: 5px 8px; border-radius: 7px; background: var(--wall); color: var(--ink); }
  .labels b:last-child { text-align: right; }
  .bar { position: absolute; top: 0; bottom: 0; left: var(--split); width: 2px; margin-left: -1px; background: var(--ink); pointer-events: none; transition: opacity .3s; }
  .knob { position: absolute; top: 50%; left: 50%; width: 40px; height: 40px; margin: -20px; border-radius: 50%; background: var(--ink); color: var(--wall); display: grid; place-items: center; box-shadow: 0 6px 16px rgb(20 40 160 / .4), 0 0 0 4px var(--paper); }
  #cmp-range { position: absolute; inset: 0; width: 100%; height: 100%; opacity: 0; margin: 0; cursor: ew-resize; }
  .glass2:has(#cmp-range:focus-visible) .knob { outline: 3px solid var(--alert); outline-offset: 3px; }

  /* difference mode: the two looks stand apart, the divider goes */
  .compare.diff .side.a { clip-path: inset(0 50% 0 0); }
  .compare.diff .side.b { clip-path: inset(0 0 0 50%); }
  .compare.diff .side.a .fig2 { transform: translateX(calc(-25cqw + var(--align-x))) scale(.55); } .compare.diff .side.b .fig2 { transform: translateX(calc(25cqw + var(--align-x))) scale(.55); }
  .compare.diff .side .fig2 { transition: transform .8s var(--spring); }
  .compare.diff .bar { opacity: 0; }

  .rows { list-style: none; margin: 0; padding: 0; position: relative; display: grid; width: 100%; grid-template-columns: repeat(2, minmax(0, 1fr)); align-content: start; gap: 6px; padding: 4px; scrollbar-gutter: stable; }
  .row { min-width: 0; display: grid; grid-template-columns: 44px minmax(0, 1fr) auto 26px; gap: 10px; align-items: center; padding: 4px 10px 4px 4px; border-radius: 12px; background: var(--paper); box-shadow: 0 1px 0 var(--line); order: var(--o); transition: box-shadow .3s, background .3s; }
  .row .th { display: block; border-radius: 9px; overflow: hidden; height: 44px; }
  .nm { display: grid; min-width: 0; line-height: 1.2; }
  .nm b { font-size: 14px; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
  .nm small { font-size: 12px; color: var(--ink-3); }
  .pres { display: inline-flex; gap: 3px; }
  .pres i { width: 8px; height: 22px; border-radius: 3px; background: var(--wall-3); }
  .pres i.on:first-child { background: var(--curtain); } .pres i.on:last-child { background: var(--alert); }
  .sign { font-style: normal; font-weight: 800; width: 24px; height: 24px; border-radius: 7px; display: grid; place-items: center; background: var(--wall-2); color: var(--ink-3); transition: background .3s, color .3s; }
  .gh { grid-column: 1 / -1; display: none; font-size: 12px; font-weight: 800; letter-spacing: .03em; text-transform: uppercase; color: var(--ink-3); padding: 8px 4px 2px; }

  .compare.diff .rows { gap: 6px; }
  .compare.diff .row.a { order: calc(10 + var(--o)); } .compare.diff .row.both { order: calc(30 + var(--o)); } .compare.diff .row.b { order: calc(50 + var(--o)); }
  .compare.diff .gh { display: block; animation: rise .5s var(--ease) backwards; }
  .compare.diff .gh-a { order: 9; } .compare.diff .gh-both { order: 29; } .compare.diff .gh-b { order: 49; }
  .compare.diff .row.a .sign { background: var(--bad); color: #fff; } .compare.diff .row.b .sign { background: var(--ok); color: #fff; }
  :root[data-theme='dark'] .compare.diff .row.b .sign { color: #04251a; } :root[data-theme='dark'] .compare.diff .row.a .sign { color: #2a0610; }
  /* changed rows hold an amber outline until they are looked at, like a changed gate on a board */
  .compare.diff .row.a:not(.seen), .compare.diff .row.b:not(.seen) { box-shadow: 0 0 0 2px var(--alert), 0 6px 18px rgb(255 157 28 / .22); }
  @keyframes rise { from { opacity: 0; transform: translateY(8px); } }

  @media (max-width: 540px) { .rows { grid-template-columns: minmax(0, 1fr); } }
  @media (prefers-reduced-motion: reduce) { .fig2, .compare.diff .side .fig2 { transition: none; } }
</style>

<script>
  import { initCompare } from '../scripts/compare';
  initCompare();
</script>
