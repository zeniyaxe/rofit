---
import { star, hero as o, knownItems, buyNow, money } from '../lib/real';
import { examplePrice } from '../lib/example-price';
import Hanger from './Hanger.astro';

const items = knownItems(o).slice(0, 5);
const forSale = buyNow(o);
---
<section class="scene share" data-scene data-phases="0 .18 .4 .68 .84 1" id="share" aria-labelledby="share-h">
  <div class="stage">
    <div class="copy" aria-live="polite">
      <h2 id="share-h">Take it with you.</h2>
      <p class="line l1">Save an outfit as a PNG with its avatar, items, and prices.</p>
      <button class="btn btn-solid save" id="share-save" type="button" disabled>
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 3v12M7 10l5 5 5-5M5 21h14" /></svg>
        Save this card as a PNG
      </button>
      <p class="hint" id="share-hint" aria-live="polite"></p>
    </div>

    <div class="card-wrap">
      <div class="card" id="share-card" data-outfit={o.id}>
        <div class="left">
          <img class="av" src={o.thumb} alt={`${o.name}, a saved outfit by ${star.displayName}`} width="420" height="420" />
          <b class="title"><span>{o.name}</span></b>
          <small class="meta">{star.displayName} · {o.assets.length} items · real public profile</small>
        </div>
        <div class="right">
          <small class="count">{o.assets.length} ITEMS</small>
          <ul>
            {items.map((i, n) => (
              <li style={`--i:${n}`}>
                <span class="th"><img src={i.thumb!} alt="" width="50" height="50" loading="lazy" /></span>
                <span class="t"><b>{i.name}</b><small>{i.typeName.replace(/Accessory$/, '')}</small></span>
                <em class="num">{i.forSale && i.price != null ? (i.price === 0 ? 'Free' : money(i.price)) : examplePrice(i.id)}</em>
              </li>
            ))}
          </ul>
          <div class="foot2">
            <div class="tot"><b class="num">{money(forSale)}</b><small>For-sale total</small></div>
            <span class="stamp"><Hanger size={20} stroke={2.4} />RoFit</span>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .scene { position: relative; height: 330svh; --p: 0; --p1: 0; --p2: 0; --p3: 0; --p4: 0; --p5: 0; margin-top: clamp(80px, 12vw, 160px); }
  .stage { position: sticky; top: 0; height: 100svh; display: grid; grid-template-columns: minmax(0, .8fr) minmax(0, 1.5fr); gap: clamp(24px, 4vw, 64px); align-items: center; padding: var(--nav-h) var(--gutter) 0; width: min(100%, calc(var(--maxw) + var(--gutter) * 2)); margin-inline: auto; overflow: hidden; }
  h2 { font-size: clamp(2rem, 4.2vw, 4rem); letter-spacing: -.035em; }
  .copy p { margin-top: 18px; color: var(--ink-2); max-width: 34ch; }
  .line { transition: opacity .4s; }
  .save { margin-top: 26px; opacity: var(--p5); transform: translateY(calc((1 - var(--p5)) * 14px)); }
  .save:disabled { cursor: default; }
  .save:not(:disabled) { cursor: pointer; }
  .hint { font-size: 14px; min-height: 1.4em; }

  .card-wrap { container-type: inline-size; }
  .card { position: relative; aspect-ratio: 1200 / 675; border-radius: 1.7cqw; background: var(--card-bg, #fff); color: #14151a; box-shadow: 0 1px 0 rgb(0 0 0 / .06), 0 calc(10px + var(--p5) * 30px) calc(24px + var(--p5) * 50px) rgb(15 20 60 / calc(.12 + var(--p5) * .14));
    transform: translateY(calc((1 - var(--p1)) * 60px - var(--p5) * 14px)) rotate(calc(var(--p5) * -1.6deg)) scale(calc(.9 + var(--p1) * .1 + var(--p5) * .015)); opacity: calc(.15 + var(--p1) * .85); display: grid; grid-template-columns: 40cqw 1fr; gap: 3.3cqw; padding: 3.33cqw; }
  .card, .card * { --paper: #fff; }
  .left { position: relative; background: #f5f6f9; border-radius: 1.7cqw; display: grid; align-content: end; padding: 2cqw 2cqw 2.2cqw; overflow: hidden; }
  .av { position: absolute; left: 50%; top: -3cqw; width: 40cqw; height: auto; object-fit: contain; transform: translateX(-50%) scale(calc(.75 + var(--p1) * .25)); transform-origin: 50% 100%; opacity: var(--p1); }
  .title { font-family: var(--f-display); font-size: 3cqw; letter-spacing: -.03em; display: block; line-height: 1.1; position: relative; }
  .title span { display: inline-block; clip-path: inset(0 calc((1 - var(--p2)) * 100%) 0 0); white-space: nowrap; }
  .meta { color: #6a7287; font-size: 1.75cqw; margin-top: .6cqw; opacity: var(--p2); position: relative; }
  .right { display: grid; grid-template-rows: auto 1fr auto; padding: .6cqw 0; min-width: 0; }
  .count { font-weight: 800; font-size: 1.4cqw; letter-spacing: .04em; color: #6a7287; opacity: var(--p2); }
  ul { list-style: none; margin: 1.4cqw 0 0; padding: 0; display: grid; align-content: start; gap: 1.1cqw; }
  li { display: grid; grid-template-columns: 5.2cqw 1fr auto; gap: 1.6cqw; align-items: center; opacity: clamp(0, var(--p3) * 7 - var(--i), 1); transform: translateX(calc((1 - clamp(0, var(--p3) * 7 - var(--i), 1)) * 24px)); }
  .th { display: block; border-radius: 1cqw; overflow: hidden; height: 5.2cqw; }
  .th img { width: 100%; height: 100%; object-fit: contain; display: block; background: #f1f2f6; }
  .t { display: grid; min-width: 0; line-height: 1.2; }
  .t b { font-size: 1.9cqw; font-weight: 800; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
  .t small { font-size: 1.45cqw; color: #6a7287; }
  li em { white-space: nowrap; font-style: normal; font-weight: 800; font-size: 1.9cqw; }
  .foot2 { display: flex; align-items: flex-end; justify-content: space-between; border-top: 2px solid #e3e4e8; padding-top: 1.6cqw; margin-top: 1.6cqw; }
  .tot { opacity: var(--p4); transform: translateY(calc((1 - var(--p4)) * 12px)); }
  .tot b { font-family: var(--f-display); font-size: 4.2cqw; letter-spacing: -.03em; display: block; line-height: 1; }
  .tot small { font-size: 1.5cqw; color: #6a7287; }
  .stamp { display: inline-flex; align-items: center; gap: .8cqw; font-family: var(--f-display); font-weight: 800; font-size: 1.9cqw; color: var(--curtain); opacity: var(--p4); transform: scale(calc(1.7 - var(--p4) * .7)) rotate(calc((1 - var(--p4)) * -14deg)); transform-origin: 100% 100%; }

  .scene.static, :global(html:not(.js)) .scene { height: auto; --p1: 1; --p2: 1; --p3: 1; --p4: 1; --p5: 1; }
  .scene.static .stage, :global(html:not(.js)) .stage { position: relative; height: auto; padding-bottom: 20px; }
  :global(html:not(.js)) .save { display: none; }

  @media (max-width: 860px) {
    .scene { height: 300svh; }
    .stage { grid-template-columns: 1fr; align-content: start; gap: 14px; padding-top: calc(var(--nav-h) + 8px); }
    h2 { font-size: 1.9rem; }
    .copy .l1 { margin-top: 8px; font-size: 15px; }
    .save { margin-top: 12px; }
    .copy p { max-width: none; }
    .card { aspect-ratio: auto; grid-template-columns: 1fr; gap: 4cqw; padding: 5cqw; border-radius: 4cqw; }
    .left { min-height: 62cqw; border-radius: 3cqw; padding: 3.4cqw; }
    .av { width: 58cqw; top: -6cqw; }
    .title { font-size: 6.4cqw; } .meta { font-size: 3.6cqw; margin-top: 1cqw; }
    .count { font-size: 3.2cqw; }
    ul { gap: 2.4cqw; margin-top: 3cqw; }
    li { grid-template-columns: 11cqw 1fr auto; gap: 3.4cqw; }
    .th { height: 11cqw; border-radius: 2cqw; }
    .t b { font-size: 4.2cqw; } .t small { font-size: 3.3cqw; } li em { font-size: 3.5cqw; }
    .foot2 { margin-top: 3.4cqw; padding-top: 3.4cqw; } .tot b { font-size: 8cqw; } .tot small { font-size: 3.4cqw; } .stamp { font-size: 4.2cqw; gap: 1.6cqw; }
    .scene.static .stage { padding-top: 40px; }
  }
</style>

<script>
  import { initShare } from '../scripts/share';
  initShare();
</script>
