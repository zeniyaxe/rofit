---
---
<section class="scene priv" data-scene data-phases="0 .28 .56 1" id="private" aria-labelledby="priv-h">
  <div class="stage">
    <div class="copy">
      <h2 id="priv-h">Some curtains stay shut.</h2>
      <p>If a player keeps their outfits private, Roblox says no, and so does RoFit. It never tries another way in.</p>
      <p class="said" aria-live="polite">What the extension says: <q>Roblox only hands saved outfits to people the owner allows. RoFit shows what Roblox returns to you and never works around privacy.</q></p>
    </div>

    <div class="rig">
      <div class="mirror3">
        <div class="glass3">
          <div class="who"><span class="av"></span><div><b>quiet</b><small>sample profile</small></div></div>
          <div class="tabs"><span>About</span><span>Creations</span><span class="on">Outfits</span></div>
          <p class="load">Loading outfits<i></i><i></i><i></i></p>
          <div class="skel"><span></span><span></span><span></span><span></span><span></span><span></span></div>

          <div class="panel l" aria-hidden="true"><div class="cloth"></div></div>
          <div class="panel r" aria-hidden="true"><div class="cloth"></div></div>

          <div class="msg" role="status">
            <span class="lock" aria-hidden="true">
              <svg width="54" height="54" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="4" y="11" width="16" height="10" rx="2.5" /><path class="shackle" d="M8 11V8a4 4 0 0 1 8 0v3" /></svg>
            </span>
            <b>quiet’s outfits are private</b>
            <small>Roblox refused the request. Nothing else was tried.</small>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .scene { position: relative; height: 260svh; --p: 0; --p1: 0; --p2: 0; --p3: 0; margin-top: clamp(80px, 12vw, 160px); }
  .stage { position: sticky; top: 0; height: 100svh; display: grid; grid-template-columns: minmax(0, .9fr) minmax(0, 1.2fr); gap: clamp(24px, 5vw, 80px); align-items: center; padding: var(--nav-h) var(--gutter) 0; width: min(100%, calc(var(--maxw) + var(--gutter) * 2)); margin-inline: auto; overflow: hidden; }
  h2 { font-size: clamp(2rem, 4.2vw, 4rem); letter-spacing: -.035em; }
  .copy p { margin-top: 18px; color: var(--ink-2); max-width: 36ch; }
  .said { font-size: 15px; opacity: var(--p3); transform: translateY(calc((1 - var(--p3)) * 10px)); }
  .said q { display: block; margin-top: 8px; color: var(--ink); font-weight: 600; quotes: none; }

  .mirror3 { padding: 12px; border-radius: 22px 22px 6px 6px; background: linear-gradient(135deg, #e7ebf6, #aab3c8 45%, #dde2ee 60%, #8d97ad); box-shadow: 0 30px 60px rgb(10 15 60 / .22); }
  .glass3 { container-type: inline-size; position: relative; aspect-ratio: 1 / 1.02; border-radius: 12px 12px 2px 2px; background: var(--paper); overflow: hidden; padding: 6cqw; color: var(--ink); }
  .who { display: flex; align-items: center; gap: 3cqw; }
  .av { width: 11cqw; height: 11cqw; border-radius: 50%; background: var(--wall-3); }
  .who b { display: block; font-family: var(--f-display); font-size: 5cqw; letter-spacing: -.03em; } .who small { color: var(--ink-3); font-size: 2.6cqw; }
  .tabs { display: flex; margin-top: 4cqw; border-bottom: 1px solid var(--line); }
  .tabs span { flex: 1; text-align: center; padding: 2.4cqw 0; font-weight: 700; font-size: 3cqw; color: var(--ink-3); } .tabs .on { color: var(--ink); box-shadow: inset 0 -2px var(--ink); }
  .load { margin-top: 4cqw; font-size: 3cqw; color: var(--ink-3); font-weight: 600; }
  .load i { display: inline-block; width: .5em; height: .5em; border-radius: 50%; background: currentColor; margin-left: .3em; animation: dots 1.2s infinite; }
  .load i:nth-child(2) { animation-delay: .15s; } .load i:nth-child(3) { animation-delay: .3s; }
  @keyframes dots { 0%, 60%, 100% { opacity: .25; } 30% { opacity: 1; } }
  :global(html:not([data-motion='full'])) .load i { animation: none; }
  .skel { display: grid; grid-template-columns: repeat(3, 1fr); gap: 3cqw; margin-top: 3cqw; }
  .skel span { aspect-ratio: 1; border-radius: 2.4cqw; background: var(--wall-2); }

  .panel { position: absolute; top: 0; bottom: 0; width: 50.5%; z-index: 4; }
  .panel .cloth { position: absolute; inset: 0; background:
      repeating-linear-gradient(90deg, rgb(0 0 50 / .3) 0 2px, transparent 2px 13px, rgb(255 255 255 / .09) 13px 18px, transparent 18px 31px),
      linear-gradient(180deg, rgb(255 255 255 / .16), transparent 14%, transparent 70%, rgb(0 0 40 / .22)), var(--curtain); }
  .panel.l { left: 0; transform: translateX(calc(-100% + var(--p1) * 100%)); }
  .panel.r { right: 0; transform: translateX(calc(100% - var(--p1) * 100%)); }
  .msg { position: absolute; inset: 0; z-index: 5; display: grid; place-content: center; justify-items: center; gap: 2cqw; text-align: center; color: #fff; padding: 8cqw; opacity: var(--p2); transform: translateY(calc((1 - var(--p2)) * 14px)); }
  .msg b { font-family: var(--f-display); font-size: 5.2cqw; letter-spacing: -.03em; line-height: 1.1; max-width: 14ch; }
  .msg small { font-size: 3cqw; color: var(--on-curtain-2); max-width: 26ch; }
  .lock { width: 14cqw; height: 14cqw; border-radius: 4cqw; background: rgb(255 255 255 / .16); display: grid; place-items: center; }
  .lock svg { width: 8.6cqw; height: 8.6cqw; }
  .shackle { transform-box: fill-box; transform-origin: 100% 100%; transform: translateY(calc((1 - var(--p2)) * -3px)) rotate(calc((1 - var(--p2)) * -20deg)); }

  .scene.static, :global(html:not(.js)) .scene { height: auto; --p1: 1; --p2: 1; --p3: 1; }
  .scene.static .stage, :global(html:not(.js)) .stage { position: relative; height: auto; padding-bottom: 20px; }
  @media (max-width: 860px) { .scene { height: 240svh; } .stage { grid-template-columns: 1fr; align-content: center; gap: 22px; } .glass3 { aspect-ratio: 1 / .9; } .copy p { max-width: none; } .said { display: none; } }
</style>

<script>
  // When the curtain is shut the page goes quiet: idle sway everywhere pauses until you scroll back out.
  const s = document.getElementById('private');
  if (s) new MutationObserver(() => document.documentElement.classList.toggle('hush', s.dataset.step === '3')).observe(s, { attributes: true, attributeFilter: ['data-step'] });
</script>
