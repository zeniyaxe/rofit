---
import '../styles/global.css';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import { SITE } from '../config';

interface Props { title?: string; description?: string; curtain?: boolean; noindex?: boolean; ogImage?: string; type?: 'website' | 'article'; bare?: boolean; valance?: boolean }
const { title, description = SITE.description, curtain = false, noindex = false, ogImage = '/og.png', type = 'website', bare = false, valance = false } = Astro.props;
const full = title ? `${title} · RoFit` : `RoFit: ${SITE.tagline}`;
const canonical = new URL(Astro.url.pathname.replace(/\/$/, '') || '/', SITE.url).href;
const og = new URL(ogImage, SITE.url).href;
---
<!doctype html>
<html lang="en" data-theme="light" data-motion="full">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{full}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex" />}
    <meta name="theme-color" content="#2a4bff" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <meta property="og:type" content={type} />
    <meta property="og:site_name" content="RoFit" />
    <meta property="og:title" content={full} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={og} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={full} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={og} />
    <script is:inline>
      // Runs before paint so there is no flash: resolve theme + motion from stored preference, falling back to the OS.
      (function () {
        var d = document.documentElement, t = 'system', m = 'system';
        try { t = localStorage.getItem('rofit-theme') || 'system'; m = localStorage.getItem('rofit-motion') || 'system'; } catch (e) {}
        var dark = matchMedia('(prefers-color-scheme: dark)').matches, reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;
        d.dataset.themePref = t; d.dataset.motionPref = m;
        d.dataset.theme = t === 'system' ? (dark ? 'dark' : 'light') : t;
        d.dataset.motion = m === 'system' ? (reduce ? 'reduced' : 'full') : m;
        d.classList.add('js');
      })();
    </script>
    <slot name="head" />
  </head>
  <body>
    <a class="skip" href="#main">Skip to content</a>
    {!bare && <Nav curtain={curtain} valance={valance} />}
    <main id="main"><slot /></main>
    {!bare && <Footer />}
    <script>
      // Elements marked .rv fade/rise in once as they enter the viewport. Content is visible without JS.
      const els = document.querySelectorAll<HTMLElement>('.rv');
      if ('IntersectionObserver' in window) {
        const io = new IntersectionObserver((es) => es.forEach((e) => { if (e.isIntersecting) { e.target.classList.add('in'); io.unobserve(e.target); } }), { rootMargin: '0px 0px -8% 0px', threshold: 0.08 });
        els.forEach((e) => io.observe(e));
      } else els.forEach((e) => e.classList.add('in'));
    </script>
  </body>
</html>
